# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -run-pass=mos-conventional-ssa,livevars -verify-machineinstrs -o - %s | FileCheck %s

# Reserve at the nearest common dominator (bb.1), not at function entry. The
# undefined reservation is live through the branch, then killed by each exit
# PCOPY. The meaningful PCOPY results remain live to the PHI, whose result is
# killed by the ordinary entry PCOPY. No reservation operand is marked undef.
---
name: reservation_liveness
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: reservation_liveness
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.5(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
  ; CHECK-NEXT:   CmpBrZero %bb.5, undef $z, 1, killed [[LDAbs]], implicit-def dead $c
  ; CHECK-NEXT:   JMP %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:gpr = IMPLICIT_DEF
  ; CHECK-NEXT:   [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
  ; CHECK-NEXT:   CmpBrZero %bb.3, undef $z, 1, [[LDAbs1]], implicit-def dead $c
  ; CHECK-NEXT:   JMP %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PCOPY:%[0-9]+]]:gpr = PCOPY killed [[LDAbs1]], implicit killed [[DEF]]
  ; CHECK-NEXT:   JMP %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[LDAbs2:%[0-9]+]]:gpr = LDAbs 1002
  ; CHECK-NEXT:   [[PCOPY1:%[0-9]+]]:gpr = PCOPY killed [[LDAbs2]], implicit killed [[DEF]]
  ; CHECK-NEXT:   JMP %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[PCOPY]], %bb.2, [[PCOPY1]], %bb.3
  ; CHECK-NEXT:   [[PCOPY2:%[0-9]+]]:gpr = PCOPY killed [[PHI]]
  ; CHECK-NEXT:   STAbs killed [[PCOPY2]], 2000
  ; CHECK-NEXT:   RTS
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   RTS
  bb.0:
    successors: %bb.1, %bb.5
    %0:gpr = LDAbs 1000
    CmpBrZero %bb.5, undef $z, 1, %0, implicit-def $c
    JMP %bb.1
  bb.1:
    successors: %bb.2, %bb.3
    %1:gpr = LDAbs 1001
    CmpBrZero %bb.3, undef $z, 1, %1, implicit-def $c
    JMP %bb.2
  bb.2:
    JMP %bb.4
  bb.3:
    %2:gpr = LDAbs 1002
    JMP %bb.4
  bb.4:
    %3:gpr = PHI %1, %bb.2, %2, %bb.3
    STAbs %3, 2000
    RTS
  bb.5:
    RTS
...

# A loop still needs the undefined reservation on its next iteration. Neither
# the initial exit PCOPY nor the backedge exit PCOPY kills that SSA variable.
---
name: loop_reservation
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: loop_reservation
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:gpr = IMPLICIT_DEF
  ; CHECK-NEXT:   [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
  ; CHECK-NEXT:   [[PCOPY:%[0-9]+]]:gpr = PCOPY killed [[LDAbs]], implicit [[DEF]]
  ; CHECK-NEXT:   JMP %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[PCOPY]], %bb.0, %6, %bb.1
  ; CHECK-NEXT:   [[PCOPY1:%[0-9]+]]:gpr = PCOPY killed [[PHI]]
  ; CHECK-NEXT:   [[IncMB:%[0-9]+]]:gpr = IncMB killed [[PCOPY1]](tied-def 0), implicit-def dead $c, implicit-def dead $v
  ; CHECK-NEXT:   [[PCOPY2:%[0-9]+]]:gpr = PCOPY [[IncMB]], implicit [[DEF]]
  ; CHECK-NEXT:   CmpBrZero %bb.1, undef $z, 1, [[IncMB]], implicit-def dead $c
  ; CHECK-NEXT:   JMP %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   STAbs killed [[IncMB]], 2000
  ; CHECK-NEXT:   RTS
  bb.0:
    %0:gpr = LDAbs 1000
    JMP %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    %1:gpr = PHI %0, %bb.0, %2, %bb.1
    %2:gpr = IncMB %1(tied-def 0), implicit-def $c, implicit-def $v
    CmpBrZero %bb.1, undef $z, 1, %2, implicit-def $c
    JMP %bb.2
  bb.2:
    STAbs %2, 2000
    RTS
...
