# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -run-pass=mos-imag-regalloc -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=mos -run-pass=mos-imag-regalloc -verify-machineinstrs %s -o %t
# RUN: FileCheck %s --check-prefix=ASSIGN --input-file=%t

# Reconstructing an opaque pair from its projections recovers its whole value
# number. Copies preserve both component and whole identities, so all these
# simultaneously live whole values can share the incoming pair's backing.
---
name: reconstruct_pair
# ASSIGN-LABEL: name: reconstruct_pair
# ASSIGN: id: 0, {{.*}}assigned-phys: '$rs1'
# ASSIGN: id: 1, {{.*}}assigned-phys: '$rc4'
# ASSIGN: id: 2, {{.*}}assigned-phys: '$rc5'
# ASSIGN: id: 3, {{.*}}assigned-phys: '$rc4'
# ASSIGN: id: 4, {{.*}}assigned-phys: '$rs1'
# ASSIGN: id: 5, {{.*}}assigned-phys: '$rs1'
tracksRegLiveness: true
# Instruction selection can leave an unused generic register behind.
registers:
  - { id: 0, class: imag16 }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
  - { id: 3, class: gpr }
  - { id: 4, class: imag16 }
  - { id: 5, class: imag16 }
  - { id: 6, class: _ }
body: |
  bb.0:
    liveins: $rs0
    ; CHECK-LABEL: name: reconstruct_pair
    ; CHECK: [[COPY:%[0-9]+]]:imag16 = COPY $rs0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY [[COPY]].sublo
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr = COPY [[COPY]].subhi
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:gpr = COPY [[COPY1]]
    ; CHECK-NEXT: [[REG_SEQUENCE:%[0-9]+]]:imag16 = REG_SEQUENCE [[COPY3]], %subreg.sublo, [[COPY2]], %subreg.subhi
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:imag16 = COPY [[REG_SEQUENCE]]
    ; CHECK-NEXT: $rs0 = COPY killed [[COPY]]
    ; CHECK-NEXT: $rs0 = COPY killed [[REG_SEQUENCE]]
    ; CHECK-NEXT: $rs0 = COPY killed [[COPY4]]
    ; CHECK-NEXT: STAbs killed [[COPY1]], 1000
    ; CHECK-NEXT: STAbs killed [[COPY2]], 1001
    ; CHECK-NEXT: STAbs killed [[COPY3]], 1002
    ; CHECK-NEXT: RTS
    %0:imag16 = COPY $rs0
    %1:gpr = COPY %0.sublo
    %2:gpr = COPY %0.subhi
    %3:gpr = COPY %1
    %4:imag16 = REG_SEQUENCE %3, %subreg.sublo, %2, %subreg.subhi
    %5:imag16 = COPY %4
    $rs0 = COPY %0
    $rs0 = COPY %4
    $rs0 = COPY %5
    STAbs %1, 1000
    STAbs %2, 1001
    STAbs %3, 1002
    RTS
...

# Separate constructions with the same components have one identity. Reversing
# the components changes the value and needs a different backing pair while
# both are live. The repeated low component also exercises equal pair lanes.
---
name: sequence_identity
# ASSIGN-LABEL: name: sequence_identity
# ASSIGN: id: 2, {{.*}}assigned-phys: '$rs2'
# ASSIGN: id: 3, {{.*}}assigned-phys: '$rs2'
# ASSIGN: id: 4, {{.*}}assigned-phys: '$rs3'
# ASSIGN: id: 5, {{.*}}assigned-phys: '$rs4'
# ASSIGN: id: 6, {{.*}}assigned-phys: '$rs4'
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: sequence_identity
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; CHECK-NEXT: [[REG_SEQUENCE:%[0-9]+]]:imag16 = REG_SEQUENCE [[LDAbs]], %subreg.sublo, [[LDAbs1]], %subreg.subhi
    ; CHECK-NEXT: [[REG_SEQUENCE1:%[0-9]+]]:imag16 = REG_SEQUENCE [[LDAbs]], %subreg.sublo, [[LDAbs1]], %subreg.subhi
    ; CHECK-NEXT: [[REG_SEQUENCE2:%[0-9]+]]:imag16 = REG_SEQUENCE killed [[LDAbs1]], %subreg.sublo, [[LDAbs]], %subreg.subhi
    ; CHECK-NEXT: [[REG_SEQUENCE3:%[0-9]+]]:imag16 = REG_SEQUENCE [[LDAbs]], %subreg.sublo, [[LDAbs]], %subreg.subhi
    ; CHECK-NEXT: [[REG_SEQUENCE4:%[0-9]+]]:imag16 = REG_SEQUENCE [[LDAbs]], %subreg.sublo, [[LDAbs]], %subreg.subhi
    ; CHECK-NEXT: $rs0 = COPY killed [[REG_SEQUENCE]]
    ; CHECK-NEXT: $rs0 = COPY killed [[REG_SEQUENCE1]]
    ; CHECK-NEXT: $rs0 = COPY killed [[REG_SEQUENCE2]]
    ; CHECK-NEXT: $rs0 = COPY killed [[REG_SEQUENCE3]]
    ; CHECK-NEXT: $rs0 = COPY killed [[REG_SEQUENCE4]]
    ; CHECK-NEXT: STAbs killed [[LDAbs]], 2000
    ; CHECK-NEXT: RTS
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    %2:imag16 = REG_SEQUENCE %0, %subreg.sublo, %1, %subreg.subhi
    %3:imag16 = REG_SEQUENCE %0, %subreg.sublo, %1, %subreg.subhi
    %4:imag16 = REG_SEQUENCE %1, %subreg.sublo, %0, %subreg.subhi
    %5:imag16 = REG_SEQUENCE %0, %subreg.sublo, %0, %subreg.subhi
    %6:imag16 = REG_SEQUENCE %0, %subreg.sublo, %0, %subreg.subhi
    $rs0 = COPY %2
    $rs0 = COPY %3
    $rs0 = COPY %4
    $rs0 = COPY %5
    $rs0 = COPY %6
    STAbs %0, 2000
    RTS
...

# A physical COPY of a pair projection records that byte's value, so a later
# virtual copy of the same projection can share the still-live physical byte.
---
name: physical_pair_projections
# ASSIGN-LABEL: name: physical_pair_projections
# ASSIGN: id: 4, {{.*}}assigned-phys: '$rc2'
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: physical_pair_projections
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; CHECK-NEXT: [[REG_SEQUENCE:%[0-9]+]]:imag16 = REG_SEQUENCE killed [[LDAbs]], %subreg.sublo, killed [[LDAbs1]], %subreg.subhi
    ; CHECK-NEXT: [[PCOPY:%[0-9]+]]:imag16 = PCOPY killed [[REG_SEQUENCE]]
    ; CHECK-NEXT: $rc2 = COPY [[PCOPY]].sublo
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY [[PCOPY]].sublo
    ; CHECK-NEXT: $a = COPY killed $rc2
    ; CHECK-NEXT: STAbs killed $a, 1002
    ; CHECK-NEXT: STAbs killed [[COPY]], 1003
    ; CHECK-NEXT: $rc2 = COPY [[PCOPY]].subhi
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY killed [[PCOPY]].subhi
    ; CHECK-NEXT: $a = COPY killed $rc2
    ; CHECK-NEXT: STAbs killed $a, 1004
    ; CHECK-NEXT: STAbs killed [[COPY1]], 1005
    ; CHECK-NEXT: RTS
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    %2:imag16 = REG_SEQUENCE %0, %subreg.sublo, %1, %subreg.subhi
    $rc2 = COPY %2.sublo
    %3:gpr = COPY %2.sublo
    $a = COPY $rc2
    STAbs $a, 1002
    STAbs %3, 1003
    $rc2 = COPY %2.subhi
    %4:gpr = COPY %2.subhi
    $a = COPY $rc2
    STAbs $a, 1004
    STAbs %4, 1005
    RTS
...
