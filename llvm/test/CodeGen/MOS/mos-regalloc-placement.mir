# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -run-pass=mos-regalloc -verify-machineinstrs -o - %s | FileCheck %s

# Loading a value from an imaginary register into A leaves the imaginary
# register valid. Overwriting all hardware copies must not add a redundant
# spill.
---
name: valid_imag_reg
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
body: |
  bb.0:
    liveins: $rc2
    ; CHECK-LABEL: name: valid_imag_reg
    ; CHECK: liveins: $rc2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $a = LDImag8 $rc2
    ; CHECK-NEXT: STAbs killed $a, 1000
    ; CHECK-NEXT: $a = LDImm 7
    ; CHECK-NEXT: $x = LDImm 8
    ; CHECK-NEXT: $y = LDImm 9
    ; CHECK-NEXT: STAbs killed $a, 1001
    ; CHECK-NEXT: STAbs killed $x, 1002
    ; CHECK-NEXT: STAbs killed $y, 1003
    ; CHECK-NEXT: $a = LDImag8 killed $rc2
    ; CHECK-NEXT: STAbs killed $a, 1004
    ; CHECK-NEXT: RTS
    %0:gpr = COPY $rc2
    $a = COPY %0
    STAbs killed $a, 1000
    $a = LDImm 7
    $x = LDImm 8
    $y = LDImm 9
    STAbs killed $a, 1001
    STAbs killed $x, 1002
    STAbs killed $y, 1003
    STAbs killed %0, 1004
    RTS
...

# A freshly computed value has no valid copy in an imaginary register.
# Overwriting all hardware copies must preserve it in its imaginary register.
---
name: invalid_imag_reg
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
body: |
  bb.0:
    ; CHECK-LABEL: name: invalid_imag_reg
    ; CHECK: $a = LDAbs 2000
    ; CHECK-NEXT: STAbs $a, 2001
    ; CHECK-NEXT: $rc2 = STImag8 killed $a
    ; CHECK-NEXT: $a = LDImm 7
    ; CHECK-NEXT: $x = LDImm 8
    ; CHECK-NEXT: $y = LDImm 9
    ; CHECK-NEXT: STAbs killed $a, 2002
    ; CHECK-NEXT: STAbs killed $x, 2003
    ; CHECK-NEXT: STAbs killed $y, 2004
    ; CHECK-NEXT: $a = LDImag8 killed $rc2
    ; CHECK-NEXT: STAbs killed $a, 2005
    ; CHECK-NEXT: RTS
    %0:gpr = LDAbs 2000
    $a = COPY %0
    STAbs killed $a, 2001
    $a = LDImm 7
    $x = LDImm 8
    $y = LDImm 9
    STAbs killed $a, 2002
    STAbs killed $x, 2003
    STAbs killed $y, 2004
    STAbs killed %0, 2005
    RTS
...

# Adding a deferred imaginary register must not forget an existing valid
# imaginary register of the same value. Evicting the value only needs to
# initialize the new imaginary register.
---
name: partially_valid_imag_regs
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
  - { id: 1, class: gpr, assigned-phys: '$rc3' }
body: |
  bb.0:
    liveins: $rc2
    ; CHECK-LABEL: name: partially_valid_imag_regs
    ; CHECK: liveins: $rc2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $a = LDImag8 $rc2
    ; CHECK-NEXT: STAbs $a, 3100
    ; CHECK-NEXT: dead $rc3 = STImag8 killed $a
    ; CHECK-NEXT: $a = LDImm 7
    ; CHECK-NEXT: $x = LDImm 8
    ; CHECK-NEXT: $y = LDImm 9
    ; CHECK-NEXT: STAbs killed $a, 3101
    ; CHECK-NEXT: STAbs killed $x, 3102
    ; CHECK-NEXT: STAbs killed $y, 3103
    ; CHECK-NEXT: $a = LDImag8 killed $rc2
    ; CHECK-NEXT: STAbs $a, 3104
    ; CHECK-NEXT: STAbs killed $a, 3105
    ; CHECK-NEXT: RTS
    %0:gpr = COPY $rc2
    STAbs %0, 3100
    %1:gpr = PCOPY %0
    $a = LDImm 7
    $x = LDImm 8
    $y = LDImm 9
    STAbs killed $a, 3101
    STAbs killed $x, 3102
    STAbs killed $y, 3103
    STAbs killed %0, 3104
    STAbs killed %1, 3105
    RTS
...

# Equivalent SSA names have different imaginary registers. Once the original
# name dies, the remaining name must still be available in its own imaginary
# register or hardware, even if the copy initially reused the original's
# imaginary register.
---
name: distinct_imag_regs
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
  - { id: 1, class: gpr, assigned-phys: '$rc3' }
body: |
  bb.0:
    liveins: $rc2
    ; CHECK-LABEL: name: distinct_imag_regs
    ; CHECK: liveins: $rc2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $y = LDImag8 killed $rc2
    ; CHECK-NEXT: $rc3 = STImag8 $y
    ; CHECK-NEXT: STAbs killed $y, 3000
    ; CHECK-NEXT: $a = LDImm 13
    ; CHECK-NEXT: $rc2 = STImag8 killed $a
    ; CHECK-NEXT: $a = LDImm 7
    ; CHECK-NEXT: $x = LDImm 8
    ; CHECK-NEXT: $y = LDImm 9
    ; CHECK-NEXT: STAbs killed $a, 3001
    ; CHECK-NEXT: STAbs killed $x, 3002
    ; CHECK-NEXT: STAbs killed $y, 3003
    ; CHECK-NEXT: $a = LDImag8 killed $rc2
    ; CHECK-NEXT: STAbs killed $a, 3004
    ; CHECK-NEXT: $a = LDImag8 killed $rc3
    ; CHECK-NEXT: STAbs killed $a, 3005
    ; CHECK-NEXT: RTS
    %0:gpr = COPY $rc2
    %1:gpr = COPY %0
    STAbs killed %0, 3000
    $a = LDImm 13
    $rc2 = STImag8 killed $a
    $a = LDImm 7
    $x = LDImm 8
    $y = LDImm 9
    STAbs killed $a, 3001
    STAbs killed $x, 3002
    STAbs killed $y, 3003
    $a = LDImag8 killed $rc2
    STAbs killed $a, 3004
    STAbs killed %1, 3005
    RTS
...

# The imaginary repair pass splits a value into a call-preserved imaginary
# register. Hardware allocation must materialize that assigned location before
# the call.
---
name: assigned_call_imag_reg
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
  - { id: 1, class: gpr, assigned-phys: '$rc20' }
body: |
  bb.0:
    ; CHECK-LABEL: name: assigned_call_imag_reg
    ; CHECK: $a = LDAbs 4000
    ; CHECK-NEXT: $rc20 = STImag8 killed $a
    ; CHECK-NEXT: JSR &callee, mos_csr
    ; CHECK-NEXT: $a = LDImag8 killed $rc20
    ; CHECK-NEXT: STAbs killed $a, 4001
    ; CHECK-NEXT: RTS
    %0:gpr = LDAbs 4000
    %1:gpr = PCOPY killed %0
    JSR &callee, mos_csr
    STAbs killed %1, 4001
    RTS
...

# REG_SEQUENCE operand order does not determine byte order. A subsequent
# whole-register copy retains the identities of both source bytes.
---
name: reg_sequence_copy
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc6' }
  - { id: 1, class: gpr, assigned-phys: '$rc7' }
  - { id: 2, class: imag16, assigned-phys: '$rs1' }
  - { id: 3, class: imag16, assigned-phys: '$rs2' }
body: |
  bb.0:
    ; CHECK-LABEL: name: reg_sequence_copy
    ; CHECK: $a = LDAbs 5000
    ; CHECK-NEXT: $x = LDAbs 5001
    ; CHECK-NEXT: dead $rc3 = STImag8 $x
    ; CHECK-NEXT: dead $rc2 = STImag8 $a
    ; CHECK-NEXT: dead $rc4 = STImag8 $a
    ; CHECK-NEXT: dead $rc5 = STImag8 $x
    ; CHECK-NEXT: $rc2 = STImag8 killed $a
    ; CHECK-NEXT: $rc3 = STImag8 killed $x
    ; CHECK-NEXT: RTS implicit killed $rs1
    %0:gpr = LDAbs 5000
    %1:gpr = LDAbs 5001
    %2:imag16 = REG_SEQUENCE killed %1, %subreg.subhi, killed %0, %subreg.sublo
    %3:imag16 = COPY killed %2
    $rs1 = COPY killed %3
    RTS implicit killed $rs1
...
# Rematerialization selects the enclosing Imag16 from either byte identity.
---
name: remat_pair
tracksRegLiveness: true
registers:
  - { id: 0, class: imag16 }
  - { id: 1, class: imag16 }
body: |
  bb.0:
    ; CHECK-LABEL: name: remat_pair
    ; CHECK: $rs1 = LDImm16Remat 4660
    ; CHECK-NEXT: RTS implicit killed $rs1
    %0:imag16 = LDImm16Remat 4660
    %1:imag16 = COPY killed %0
    $rs1 = COPY killed %1
    RTS implicit killed $rs1
...

# A and X both contain the input. Selecting either as INC's use leaves the
# same register contents, but the tie forces its result into that register.
# Keep those choices distinct until defs: X avoids preservation across the
# following overwrite of A.
---
name: tied_use_choices
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, assigned-phys: '$rc2' }
  - { id: 1, class: gpr, assigned-phys: '$rc3' }
body: |
  bb.0:
    ; CHECK-LABEL: name: tied_use_choices
    ; CHECK: $a = LDAbs 6000
    ; CHECK-NEXT: $x = TA $a
    ; CHECK-NEXT: STAbs killed $a, 6001
    ; CHECK-NEXT: STAbs $x, 6002
    ; CHECK-NEXT: $x = INC killed $x
    ; CHECK-NEXT: $a = LDImm 7
    ; CHECK-NEXT: STAbs killed $a, 6003
    ; CHECK-NEXT: STAbs killed $x, 6004
    ; CHECK-NEXT: RTS
    %0:gpr = LDAbs 6000
    $a = COPY %0
    $x = COPY %0
    STAbs killed $a, 6001
    STAbs killed $x, 6002
    %1:gpr = INC killed %0
    $a = LDImm 7
    STAbs killed $a, 6003
    STAbs killed %1, 6004
    RTS
...

# Both values have valid copies in imaginary registers, and all hardware
# registers are overwritten before the swap. The PCOPY must break its cycle in
# hardware; no unassigned imaginary scratch location is available to this pass.
---
name: parallel_swap
tracksRegLiveness: true
registers:
  - { id: 0, class: imag8, assigned-phys: '$rc2' }
  - { id: 1, class: imag8, assigned-phys: '$rc3' }
  - { id: 2, class: imag8, assigned-phys: '$rc3' }
  - { id: 3, class: imag8, assigned-phys: '$rc2' }
body: |
  bb.0:
    ; CHECK-LABEL: name: parallel_swap
    ; CHECK: $y = LDImag8 $rc0
    ; CHECK-NEXT: $rc2 = STImag8 killed $y
    ; CHECK-NEXT: $y = LDImag8 $rc1
    ; CHECK-NEXT: dead $a = LDImm 7
    ; CHECK-NEXT: dead $x = LDImm 8
    ; CHECK-NEXT: $rc3 = STImag8 killed $y
    ; CHECK-NEXT: dead $y = LDImm 9
    ; CHECK-NEXT: $a = LDImag8 killed $rc3
    ; CHECK-NEXT: $x = LDImag8 killed $rc2
    ; CHECK-NEXT: dead $rc3 = STImag8 $x
    ; CHECK-NEXT: $rc0 = STImag8 killed $x
    ; CHECK-NEXT: $rc1 = STImag8 killed $a
    ; CHECK-NEXT: RTS implicit $rc0, implicit $rc1
    %0:imag8 = COPY $rc0
    %1:imag8 = COPY $rc1
    $a = LDImm 7
    $x = LDImm 8
    $y = LDImm 9
    %2:imag8, %3:imag8 = PCOPY killed %0, killed %1
    $rc0 = COPY killed %2
    $rc1 = COPY killed %3
    RTS implicit $rc0, implicit $rc1
...
