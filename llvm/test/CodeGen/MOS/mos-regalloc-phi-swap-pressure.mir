# XFAIL: *
# RUN: llc -mtriple=mos -run-pass=mos-regalloc -verify-machineinstrs %s -o /dev/null

# All 28 backing bytes are live: thirteen Imag16 values and two byte PHIs.
# With explicit backing registers, swapping the PHIs on the backedge fails:
# emitPHIEdge/evacuate require an empty imaginary byte to save a cycle source.
# Hardware registers are free at this boundary, but evacuation does not use
# them as destinations. This should compile once cycle scratch is guaranteed.
---
name: full_swap
tracksRegLiveness: true
registers:
  - { id: 0, class: imag16, assigned-phys: '$rs1' }
  - { id: 1, class: imag16, assigned-phys: '$rs2' }
  - { id: 2, class: imag16, assigned-phys: '$rs3' }
  - { id: 3, class: imag16, assigned-phys: '$rs4' }
  - { id: 4, class: imag16, assigned-phys: '$rs5' }
  - { id: 5, class: imag16, assigned-phys: '$rs6' }
  - { id: 6, class: imag16, assigned-phys: '$rs7' }
  - { id: 7, class: imag16, assigned-phys: '$rs9' }
  - { id: 8, class: imag16, assigned-phys: '$rs10' }
  - { id: 9, class: imag16, assigned-phys: '$rs11' }
  - { id: 10, class: imag16, assigned-phys: '$rs12' }
  - { id: 11, class: imag16, assigned-phys: '$rs13' }
  - { id: 12, class: imag16, assigned-phys: '$rs14' }
  - { id: 13, class: gpr, assigned-phys: '$rc30' }
  - { id: 14, class: gpr, assigned-phys: '$rc31' }
  - { id: 15, class: gpr, assigned-phys: '$rc30' }
  - { id: 16, class: gpr, assigned-phys: '$rc31' }
body: |
  bb.0:
    %0:imag16 = COPY $rs0
    %1:imag16 = COPY $rs0
    %2:imag16 = COPY $rs0
    %3:imag16 = COPY $rs0
    %4:imag16 = COPY $rs0
    %5:imag16 = COPY $rs0
    %6:imag16 = COPY $rs0
    %7:imag16 = COPY $rs0
    %8:imag16 = COPY $rs0
    %9:imag16 = COPY $rs0
    %10:imag16 = COPY $rs0
    %11:imag16 = COPY $rs0
    %12:imag16 = COPY $rs0
    %13:gpr = LDAbs 1000
    %14:gpr = LDAbs 1001
    JMP %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    %15:gpr = PHI %13, %bb.0, %16, %bb.1
    %16:gpr = PHI %14, %bb.0, %15, %bb.1
    $rs0 = COPY %0
    $rs0 = COPY %1
    $rs0 = COPY %2
    $rs0 = COPY %3
    $rs0 = COPY %4
    $rs0 = COPY %5
    $rs0 = COPY %6
    $rs0 = COPY %7
    $rs0 = COPY %8
    $rs0 = COPY %9
    $rs0 = COPY %10
    $rs0 = COPY %11
    $rs0 = COPY %12
    STAbs %15, 2000
    STAbs %16, 2001
    CmpBrZero %bb.1, undef $z, 1, %15, implicit-def $c
    JMP %bb.2
  bb.2:
    RTS
...
