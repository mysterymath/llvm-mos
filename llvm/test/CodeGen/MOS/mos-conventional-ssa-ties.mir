# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -run-pass=mos-conventional-ssa -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=mos -run-pass=mos-conventional-ssa,mos-imag-regalloc,mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=HW

# Both projections become whole-register tied inputs. The original pair remains
# live, so allocation must preserve its low byte across the destructive updates.
---
name: tied_projections
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: tied_projections
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; CHECK-NEXT: [[REG_SEQUENCE:%[0-9]+]]:imag16 = REG_SEQUENCE [[LDAbs]], %subreg.sublo, [[LDAbs1]], %subreg.subhi
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:anyi8 = COPY [[REG_SEQUENCE]].sublo
    ; CHECK-NEXT: [[IncMB:%[0-9]+]]:anyi8 = IncMB killed [[COPY]](tied-def 0), implicit-def $c, implicit-def $v
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:anyi8 = COPY [[REG_SEQUENCE]].subhi
    ; CHECK-NEXT: [[IncMB1:%[0-9]+]]:anyi8 = IncMB killed [[COPY1]](tied-def 0), implicit-def $c, implicit-def $v
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr = COPY [[REG_SEQUENCE]].sublo
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:gpr = COPY [[IncMB]]
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:gpr = COPY [[IncMB1]]
    ; CHECK-NEXT: STAbs [[COPY3]], 2000
    ; CHECK-NEXT: STAbs [[COPY4]], 2001
    ; CHECK-NEXT: STAbs [[COPY2]], 2002
    ; CHECK-NEXT: RTS
    ;
    ; HW-LABEL: name: tied_projections
    ; HW: $a = LDAbs 1000
    ; HW-NEXT: $y = LDAbs 1001
    ; HW-NEXT: dead $rc2 = STImag8 $a
    ; HW-NEXT: dead $rc3 = STImag8 $y
    ; HW-NEXT: $x = TA $a
    ; HW-NEXT: $x = IncMB killed $x(tied-def 0), implicit-def dead $c, implicit-def dead $v
    ; HW-NEXT: $y = IncMB killed $y(tied-def 0), implicit-def dead $c, implicit-def dead $v
    ; HW-NEXT: STAbs killed $x, 2000
    ; HW-NEXT: STAbs killed $y, 2001
    ; HW-NEXT: STAbs killed $a, 2002
    ; HW-NEXT: RTS
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    %2:imag16 = REG_SEQUENCE %0, %subreg.sublo, %1, %subreg.subhi
    %3:anyi8 = IncMB %2.sublo(tied-def 0), implicit-def $c, implicit-def $v
    %4:anyi8 = IncMB %2.subhi(tied-def 0), implicit-def $c, implicit-def $v
    %5:gpr = COPY %2.sublo
    %6:gpr = COPY %3
    %7:gpr = COPY %4
    STAbs %6, 2000
    STAbs %7, 2001
    STAbs %5, 2002
    RTS
...

# An undefined projection needs an undefined whole register, not an undef COPY
# introduced after ProcessImplicitDefs has already run.
---
name: undef_tied_projection
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: undef_tied_projection
    ; CHECK: [[DEF:%[0-9]+]]:imag16 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:anyi8 = IMPLICIT_DEF
    ; CHECK-NEXT: [[IncMB:%[0-9]+]]:anyi8 = IncMB undef [[DEF1]](tied-def 0), implicit-def $c, implicit-def $v
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY [[IncMB]]
    ; CHECK-NEXT: STAbs [[COPY]], 2000
    ; CHECK-NEXT: RTS
    ;
    ; HW-LABEL: name: undef_tied_projection
    ; HW: $x = IncMB undef $x(tied-def 0), implicit-def dead $c, implicit-def dead $v
    ; HW-NEXT: STAbs killed $x, 2000
    ; HW-NEXT: RTS
    %0:imag16 = IMPLICIT_DEF
    %1:anyi8 = IncMB undef %0.subhi(tied-def 0), implicit-def $c, implicit-def $v
    %2:gpr = COPY %1
    STAbs %2, 2000
    RTS
...
