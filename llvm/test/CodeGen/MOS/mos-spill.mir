# RUN: split-file %s %t
# RUN: llc -mtriple=mos -run-pass=mos-spill -verify-machineinstrs %t/valid.mir -o /dev/null
# RUN: not llc -mtriple=mos -run-pass=mos-spill -verify-machineinstrs %t/intact_pair_overflow.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=INTACT-PAIR-OVERFLOW
# RUN: not llc -mtriple=mos -run-pass=mos-spill -verify-machineinstrs %t/partial_kill_lo_overflow.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=PARTIAL-KILL-LO-OVERFLOW
# RUN: not llc -mtriple=mos -run-pass=mos-spill -verify-machineinstrs %t/partial_kill_hi_overflow.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=PARTIAL-KILL-HI-OVERFLOW
# RUN: not llc -mtriple=mos -run-pass=mos-spill -verify-machineinstrs %t/partial_overwrite_overflow.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=PARTIAL-OVERWRITE-OVERFLOW
# RUN: not llc -mtriple=mos -run-pass=mos-spill -verify-machineinstrs %t/partial_unused_lo_overflow.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=PARTIAL-UNUSED-LO-OVERFLOW
# RUN: not llc -mtriple=mos -run-pass=mos-spill -verify-machineinstrs %t/physical_early_clobber_overflow.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=PHYSICAL-EARLY-CLOBBER-OVERFLOW
# RUN: not llc -mtriple=mos -run-pass=mos-spill -verify-machineinstrs %t/imag8-overflow.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=IMAG8-OVERFLOW
# RUN: not llc -mtriple=mos -run-pass=mos-spill -verify-machineinstrs %t/imag16-overflow.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=IMAG16-OVERFLOW

# Physical pressure does not constrain imaginary register selection, so test its
# accounting at the capacity boundary: correct demand fits and one extra value
# fails. There are 28 Imag8 and 14 Imag16 locations. Copies to reserved rc0/rs0
# consume values without adding physical imaginary register demand.

#--- valid.mir
# More live copies than imaginary registers still fit: each new definition holds
# the same value as every earlier assignment, so none of them blocks it.
---
name: equal_copies
tracksRegLiveness: true
body: |
  bb.0:
    %0:gpr = LDAbs 1000
    %1:gpr = COPY %0
    %2:gpr = COPY %1
    %3:gpr = COPY %2
    %4:gpr = COPY %3
    %5:gpr = COPY %4
    %6:gpr = COPY %5
    %7:gpr = COPY %6
    %8:gpr = COPY %7
    %9:gpr = COPY %8
    %10:gpr = COPY %9
    %11:gpr = COPY %10
    %12:gpr = COPY %11
    %13:gpr = COPY %12
    %14:gpr = COPY %13
    %15:gpr = COPY %14
    %16:gpr = COPY %15
    %17:gpr = COPY %16
    %18:gpr = COPY %17
    %19:gpr = COPY %18
    %20:gpr = COPY %19
    %21:gpr = COPY %20
    %22:gpr = COPY %21
    %23:gpr = COPY %22
    %24:gpr = COPY %23
    %25:gpr = COPY %24
    %26:gpr = COPY %25
    %27:gpr = COPY %26
    %28:gpr = COPY %27
    STAbs %0, 2000
    STAbs %1, 2001
    STAbs %2, 2002
    STAbs %3, 2003
    STAbs %4, 2004
    STAbs %5, 2005
    STAbs %6, 2006
    STAbs %7, 2007
    STAbs %8, 2008
    STAbs %9, 2009
    STAbs %10, 2010
    STAbs %11, 2011
    STAbs %12, 2012
    STAbs %13, 2013
    STAbs %14, 2014
    STAbs %15, 2015
    STAbs %16, 2016
    STAbs %17, 2017
    STAbs %18, 2018
    STAbs %19, 2019
    STAbs %20, 2020
    STAbs %21, 2021
    STAbs %22, 2022
    STAbs %23, 2023
    STAbs %24, 2024
    STAbs %25, 2025
    STAbs %26, 2026
    STAbs %27, 2027
    STAbs %28, 2028
    RTS
...

# One physical pair plus thirteen virtual pairs fits; splitting the physical
# pair into two byte demands would reject the last virtual pair.
---
name: intact_pair
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rs1
    %0:imag16 = COPY $rs0
    %1:imag16 = COPY $rs0
    %2:imag16 = COPY $rs0
    %3:imag16 = COPY $rs0
    %4:imag16 = COPY $rs0
    %5:imag16 = COPY $rs0
    %6:imag16 = COPY $rs0
    %7:imag16 = COPY $rs0
    %8:imag16 = COPY $rs0
    %9:imag16 = COPY $rs0
    %10:imag16 = COPY $rs0
    %11:imag16 = COPY $rs0
    %12:imag16 = COPY $rs0
    %13:imag16 = COPY $rs1
    $rs0 = COPY %0
    $rs0 = COPY %1
    $rs0 = COPY %2
    $rs0 = COPY %3
    $rs0 = COPY %4
    $rs0 = COPY %5
    $rs0 = COPY %6
    $rs0 = COPY %7
    $rs0 = COPY %8
    $rs0 = COPY %9
    $rs0 = COPY %10
    $rs0 = COPY %11
    $rs0 = COPY %12
    $rs0 = COPY %13
    RTS
...

# Killing one half leaves exactly one byte of physical demand. Thirteen
# virtual pairs and one temporary byte exactly fit.
---
name: partial_kill_lo
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rs1
    $rc0 = COPY $rc2
    %0:imag16 = COPY $rs0
    %1:imag16 = COPY $rs0
    %2:imag16 = COPY $rs0
    %3:imag16 = COPY $rs0
    %4:imag16 = COPY $rs0
    %5:imag16 = COPY $rs0
    %6:imag16 = COPY $rs0
    %7:imag16 = COPY $rs0
    %8:imag16 = COPY $rs0
    %9:imag16 = COPY $rs0
    %10:imag16 = COPY $rs0
    %11:imag16 = COPY $rs0
    %12:imag16 = COPY $rs0
    %13:gpr = LDAbs 1000
    $rs0 = COPY %0
    $rs0 = COPY %1
    $rs0 = COPY %2
    $rs0 = COPY %3
    $rs0 = COPY %4
    $rs0 = COPY %5
    $rs0 = COPY %6
    $rs0 = COPY %7
    $rs0 = COPY %8
    $rs0 = COPY %9
    $rs0 = COPY %10
    $rs0 = COPY %11
    $rs0 = COPY %12
    STAbs %13, 2000
    $rc0 = COPY $rc3
    RTS
...

