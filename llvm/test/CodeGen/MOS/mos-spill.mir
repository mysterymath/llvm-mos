    %9:imag16 = COPY $rs0
    %10:imag16 = COPY $rs0
    %11:imag16 = COPY $rs0
    %12:imag16 = COPY $rs0
    %13:gpr = LDAbs 1000
    $rs0 = COPY %0
    $rs0 = COPY %1
    $rs0 = COPY %2
    $rs0 = COPY %3
    $rs0 = COPY %4
    $rs0 = COPY %5
    $rs0 = COPY %6
    $rs0 = COPY %7
    $rs0 = COPY %8
    $rs0 = COPY %9
    $rs0 = COPY %10
    $rs0 = COPY %11
    $rs0 = COPY %12
    STAbs %13, 2000
    $rc0 = COPY $rc3
    RTS
...

# Unused recorded live-ins add no demand: fourteen virtual pairs fit.
---
name: unused_liveins
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rc2, $rs2
    %0:imag16 = COPY $rs0
    %1:imag16 = COPY $rs0
    %2:imag16 = COPY $rs0
    %3:imag16 = COPY $rs0
    %4:imag16 = COPY $rs0
    %5:imag16 = COPY $rs0
    %6:imag16 = COPY $rs0
    %7:imag16 = COPY $rs0
    %8:imag16 = COPY $rs0
    %9:imag16 = COPY $rs0
    %10:imag16 = COPY $rs0
    %11:imag16 = COPY $rs0
    %12:imag16 = COPY $rs0
    %13:imag16 = COPY $rs0
    $rs0 = COPY %0
    $rs0 = COPY %1
    $rs0 = COPY %2
    $rs0 = COPY %3
    $rs0 = COPY %4
    $rs0 = COPY %5
    $rs0 = COPY %6
    $rs0 = COPY %7
    $rs0 = COPY %8
    $rs0 = COPY %9
    $rs0 = COPY %10
    $rs0 = COPY %11
    $rs0 = COPY %12
    $rs0 = COPY %13
    RTS
...

# A use of a later definition must not make the entry value live across
# fourteen virtual pairs.
---
name: overwritten_livein
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rc2
    %0:imag16 = COPY $rs0
    %1:imag16 = COPY $rs0
    %2:imag16 = COPY $rs0
    %3:imag16 = COPY $rs0
    %4:imag16 = COPY $rs0
    %5:imag16 = COPY $rs0
    %6:imag16 = COPY $rs0
    %7:imag16 = COPY $rs0
    %8:imag16 = COPY $rs0
    %9:imag16 = COPY $rs0
    %10:imag16 = COPY $rs0
    %11:imag16 = COPY $rs0
    %12:imag16 = COPY $rs0
    %13:imag16 = COPY $rs0
    $rs0 = COPY %0
    $rs0 = COPY %1
    $rs0 = COPY %2
    $rs0 = COPY %3
    $rs0 = COPY %4
    $rs0 = COPY %5
    $rs0 = COPY %6
    $rs0 = COPY %7
    $rs0 = COPY %8
    $rs0 = COPY %9
    $rs0 = COPY %10
    $rs0 = COPY %11
    $rs0 = COPY %12
    $rs0 = COPY %13
    $rc2 = COPY $rc0
    $rc0 = COPY $rc2
    RTS
...

# Twelve virtual pairs, one byte input, and an early-clobber physical pair
# fit the conservative pair bound (12 + 1 + 1 = 14).
---
name: physical_early_clobber
tracksRegLiveness: true
body: |
  bb.0:
    %0:imag16 = COPY $rs0
    %1:imag16 = COPY $rs0
    %2:imag16 = COPY $rs0
    %3:imag16 = COPY $rs0
    %4:imag16 = COPY $rs0
    %5:imag16 = COPY $rs0
    %6:imag16 = COPY $rs0
    %7:imag16 = COPY $rs0
    %8:imag16 = COPY $rs0
    %9:imag16 = COPY $rs0
    %10:imag16 = COPY $rs0
    %11:imag16 = COPY $rs0
    %12:gpr = LDAbs 1000
    early-clobber $rs1 = STStk %12, $rs0, 0
    $rs0 = COPY %0
    $rs0 = COPY %1
    $rs0 = COPY %2
    $rs0 = COPY %3
    $rs0 = COPY %4
    $rs0 = COPY %5
    $rs0 = COPY %6
    $rs0 = COPY %7
    $rs0 = COPY %8
    $rs0 = COPY %9
    $rs0 = COPY %10
    $rs0 = COPY %11
    RTS
...

#--- intact_pair_overflow.mir
# The same physical pair must prevent a fourteenth virtual pair.
# INTACT-PAIR-OVERFLOW: MOSSpill: cannot prove imaginary register assignability in intact_pair_overflow, bb.0 for Imag16: requires 15, 14 available locations
# INTACT-PAIR-OVERFLOW: LLVM ERROR: MOSSpill spill insertion is not implemented
---
name: intact_pair_overflow
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rs1
    %0:imag16 = COPY $rs0
    %1:imag16 = COPY $rs0
    %2:imag16 = COPY $rs0
    %3:imag16 = COPY $rs0
    %4:imag16 = COPY $rs0
    %5:imag16 = COPY $rs0
    %6:imag16 = COPY $rs0
    %7:imag16 = COPY $rs0
    %8:imag16 = COPY $rs0
    %9:imag16 = COPY $rs0
    %10:imag16 = COPY $rs0
    %11:imag16 = COPY $rs0
    %12:imag16 = COPY $rs0
    %13:imag16 = COPY $rs0
    $rs0 = COPY %0
    $rs0 = COPY %1
    $rs0 = COPY %2
    $rs0 = COPY %3
    $rs0 = COPY %4
    $rs0 = COPY %5
    $rs0 = COPY %6
    $rs0 = COPY %7
    $rs0 = COPY %8
    $rs0 = COPY %9
    $rs0 = COPY %10
    $rs0 = COPY %11
    $rs0 = COPY %12
    $rs0 = COPY %13
    %14:imag16 = COPY $rs1
    $rs0 = COPY %14
    RTS
...

#--- partial_kill_lo_overflow.mir
# Adding a second temporary byte must exceed capacity; losing the surviving
# physical byte would incorrectly allow this.
# PARTIAL-KILL-LO-OVERFLOW: MOSSpill: cannot prove imaginary register assignability in partial_kill_lo_overflow, bb.0 for Imag8: requires 29, 28 available locations
# PARTIAL-KILL-LO-OVERFLOW: LLVM ERROR: MOSSpill spill insertion is not implemented
---
name: partial_kill_lo_overflow
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rs1
    $rc0 = COPY $rc2
    %0:imag16 = COPY $rs0
    %1:imag16 = COPY $rs0
    %2:imag16 = COPY $rs0
    %3:imag16 = COPY $rs0
    %4:imag16 = COPY $rs0
    %5:imag16 = COPY $rs0
    %6:imag16 = COPY $rs0
    %7:imag16 = COPY $rs0
    %8:imag16 = COPY $rs0
    %9:imag16 = COPY $rs0
    %10:imag16 = COPY $rs0
    %11:imag16 = COPY $rs0
    %12:imag16 = COPY $rs0
    %13:gpr = LDAbs 1000
    %14:gpr = LDAbs 1001
    $rs0 = COPY %0
    $rs0 = COPY %1
    $rs0 = COPY %2
    $rs0 = COPY %3
    $rs0 = COPY %4
    $rs0 = COPY %5
    $rs0 = COPY %6
    $rs0 = COPY %7
    $rs0 = COPY %8
    $rs0 = COPY %9
    $rs0 = COPY %10
    $rs0 = COPY %11
    $rs0 = COPY %12
    STAbs %13, 2000
    $rc0 = COPY $rc3
    STAbs %14, 2001
    RTS
...

