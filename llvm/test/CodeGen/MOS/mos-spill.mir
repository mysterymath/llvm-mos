#--- physical_early_clobber_overflow.mir
# With thirteen virtual pairs, the early-clobber pair cannot fit until the
# byte input dies. Releasing that input early would incorrectly allow this.
# PHYSICAL-EARLY-CLOBBER-OVERFLOW: MOSSpill: cannot prove imaginary register assignability in physical_early_clobber_overflow, bb.0 for Imag16: requires 15, 14 available locations
# PHYSICAL-EARLY-CLOBBER-OVERFLOW: LLVM ERROR: MOSSpill spill insertion is not implemented
---
name: physical_early_clobber_overflow
tracksRegLiveness: true
body: |
  bb.0:
    %0:imag16 = COPY $rs0
    %1:imag16 = COPY $rs0
    %2:imag16 = COPY $rs0
    %3:imag16 = COPY $rs0
    %4:imag16 = COPY $rs0
    %5:imag16 = COPY $rs0
    %6:imag16 = COPY $rs0
    %7:imag16 = COPY $rs0
    %8:imag16 = COPY $rs0
    %9:imag16 = COPY $rs0
    %10:imag16 = COPY $rs0
    %11:imag16 = COPY $rs0
    %12:imag16 = COPY $rs0
    %13:gpr = LDAbs 1000
    early-clobber $rs1 = STStk %13, $rs0, 0
    $rs0 = COPY %0
    $rs0 = COPY %1
    $rs0 = COPY %2
    $rs0 = COPY %3
    $rs0 = COPY %4
    $rs0 = COPY %5
    $rs0 = COPY %6
    $rs0 = COPY %7
    $rs0 = COPY %8
    $rs0 = COPY %9
    $rs0 = COPY %10
    $rs0 = COPY %11
    $rs0 = COPY %12
    RTS
...

#--- imag8-overflow.mir
# Thirteen live bytes and sixteen call clobbers require spilling.
# IMAG8-OVERFLOW: MOSSpill: cannot prove imaginary register assignability in imag8_overflow, bb.0 for Imag8: requires 29, 28 available locations
# IMAG8-OVERFLOW: JSR &callee
# IMAG8-OVERFLOW: LLVM ERROR: MOSSpill spill insertion is not implemented
---
name: imag8_overflow
tracksRegLiveness: true
body: |
  bb.0:
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    %2:gpr = LDAbs 1002
    %3:gpr = LDAbs 1003
    %4:gpr = LDAbs 1004
    %5:gpr = LDAbs 1005
    %6:gpr = LDAbs 1006
    %7:gpr = LDAbs 1007
    %8:gpr = LDAbs 1008
    %9:gpr = LDAbs 1009
    %10:gpr = LDAbs 1010
    %11:gpr = LDAbs 1011
    %12:gpr = LDAbs 1012
    JSR &callee, mos_csr
    STAbs %0, 2000
    STAbs %1, 2001
    STAbs %2, 2002
    STAbs %3, 2003
    STAbs %4, 2004
    STAbs %5, 2005
    STAbs %6, 2006
    STAbs %7, 2007
    STAbs %8, 2008
    STAbs %9, 2009
    STAbs %10, 2010
    STAbs %11, 2011
    STAbs %12, 2012
    RTS
...

#--- imag16-overflow.mir
# Fourteen live bytes could occupy all fourteen pairs. The conservative bound
# therefore rejects a new Imag16, even though the total byte demand fits.
# IMAG16-OVERFLOW: MOSSpill: cannot prove imaginary register assignability in imag16_overflow, bb.0 for Imag16: requires 15, 14 available locations
# IMAG16-OVERFLOW: %14:imag16 = COPY $rs0
# IMAG16-OVERFLOW: LLVM ERROR: MOSSpill spill insertion is not implemented
---
name: imag16_overflow
tracksRegLiveness: true
body: |
  bb.0:
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    %2:gpr = LDAbs 1002
    %3:gpr = LDAbs 1003
    %4:gpr = LDAbs 1004
    %5:gpr = LDAbs 1005
    %6:gpr = LDAbs 1006
    %7:gpr = LDAbs 1007
    %8:gpr = LDAbs 1008
    %9:gpr = LDAbs 1009
    %10:gpr = LDAbs 1010
    %11:gpr = LDAbs 1011
    %12:gpr = LDAbs 1012
    %13:gpr = LDAbs 1013
    %14:imag16 = COPY $rs0
    STAbs %0, 2000
    STAbs %1, 2001
    STAbs %2, 2002
    STAbs %3, 2003
    STAbs %4, 2004
    STAbs %5, 2005
    STAbs %6, 2006
    STAbs %7, 2007
    STAbs %8, 2008
    STAbs %9, 2009
    STAbs %10, 2010
    STAbs %11, 2011
    STAbs %12, 2012
    STAbs %13, 2013
    $rs1 = COPY %14
    RTS
...
