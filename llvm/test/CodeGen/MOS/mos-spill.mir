# A dead replacement of the low byte must leave the incoming high byte live.
# Thirteen virtual pairs and one temporary byte exactly fit.
---
name: partial_overwrite
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rs1
    $rc2 = COPY $rc0
    %0:imag16 = COPY $rs0
    %1:imag16 = COPY $rs0
    %2:imag16 = COPY $rs0
    %3:imag16 = COPY $rs0
    %4:imag16 = COPY $rs0
    %5:imag16 = COPY $rs0
    %6:imag16 = COPY $rs0
    %7:imag16 = COPY $rs0
    %8:imag16 = COPY $rs0
    %9:imag16 = COPY $rs0
    %10:imag16 = COPY $rs0
    %11:imag16 = COPY $rs0
    %12:imag16 = COPY $rs0
    %13:gpr = LDAbs 1000
    $rs0 = COPY %0
    $rs0 = COPY %1
    $rs0 = COPY %2
    $rs0 = COPY %3
    $rs0 = COPY %4
    $rs0 = COPY %5
    $rs0 = COPY %6
    $rs0 = COPY %7
    $rs0 = COPY %8
    $rs0 = COPY %9
    $rs0 = COPY %10
    $rs0 = COPY %11
    $rs0 = COPY %12
    STAbs %13, 2000
    $rc0 = COPY $rc3
    RTS
...

# Only the used half of an entry pair contributes pressure. Thirteen virtual
# pairs and one temporary byte exactly fit.
---
name: partial_unused_lo
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rs1
    %0:imag16 = COPY $rs0
    %1:imag16 = COPY $rs0
    %2:imag16 = COPY $rs0
    %3:imag16 = COPY $rs0
