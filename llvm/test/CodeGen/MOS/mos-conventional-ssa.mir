# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -run-pass=mos-conventional-ssa -verify-machineinstrs -o - %s | FileCheck %s

# The old PHI result survives on the exit edge; the backedge copy must define
# a fresh name rather than overwrite it.
---
name: lost_copy
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: lost_copy
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
  ; CHECK-NEXT:   [[PCOPY:%[0-9]+]]:gpr = PCOPY [[LDAbs]]
  ; CHECK-NEXT:   JMP %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[PCOPY]], %bb.0, %5, %bb.1
  ; CHECK-NEXT:   [[PCOPY1:%[0-9]+]]:gpr = PCOPY [[PHI]]
  ; CHECK-NEXT:   [[IncMB:%[0-9]+]]:gpr = IncMB [[PCOPY1]](tied-def 0), implicit-def $c, implicit-def $v
  ; CHECK-NEXT:   [[PCOPY2:%[0-9]+]]:gpr = PCOPY [[IncMB]]
  ; CHECK-NEXT:   CmpBrZero %bb.1, undef $z, 1, [[IncMB]], implicit-def $c
  ; CHECK-NEXT:   JMP %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   STAbs [[PCOPY1]], 2000
  ; CHECK-NEXT:   STAbs [[IncMB]], 2001
  ; CHECK-NEXT:   RTS
  bb.0:
    %0:gpr = LDAbs 1000
    JMP %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    %1:gpr = PHI %0, %bb.0, %2, %bb.1
    %2:gpr = IncMB %1(tied-def 0), implicit-def $c, implicit-def $v
    CmpBrZero %bb.1, undef $z, 1, %2, implicit-def $c
    JMP %bb.2
  bb.2:
    STAbs %1, 2000
    STAbs %2, 2001
    RTS
...
---
# Isolate all results together so mutually dependent PHIs remain parallel.
name: swap
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: swap
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
  ; CHECK-NEXT:   [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
  ; CHECK-NEXT:   [[PCOPY:%[0-9]+]]:gpr, [[PCOPY1:%[0-9]+]]:gpr = PCOPY [[LDAbs]], [[LDAbs1]]
  ; CHECK-NEXT:   JMP %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[PCOPY]], %bb.0, %7, %bb.1
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gpr = PHI [[PCOPY1]], %bb.0, %9, %bb.1
  ; CHECK-NEXT:   [[PCOPY2:%[0-9]+]]:gpr, [[PCOPY3:%[0-9]+]]:gpr = PCOPY [[PHI]], [[PHI1]]
  ; CHECK-NEXT:   STAbs [[PCOPY2]], 2000
  ; CHECK-NEXT:   STAbs [[PCOPY3]], 2001
  ; CHECK-NEXT:   [[PCOPY4:%[0-9]+]]:gpr, [[PCOPY5:%[0-9]+]]:gpr = PCOPY [[PCOPY3]], [[PCOPY2]]
  ; CHECK-NEXT:   CmpBrZero %bb.1, undef $z, 1, [[PCOPY2]], implicit-def $c
  ; CHECK-NEXT:   JMP %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RTS
  bb.0:
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    JMP %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    %2:gpr = PHI %0, %bb.0, %3, %bb.1
    %3:gpr = PHI %1, %bb.0, %2, %bb.1
    STAbs %2, 2000
    STAbs %3, 2001
    CmpBrZero %bb.1, undef $z, 1, %2, implicit-def $c
    JMP %bb.2
  bb.2:
    RTS
...
---
# Preserve the critical edge and insert before its branch, whose input survives.
name: critical_edge
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: critical_edge
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
  ; CHECK-NEXT:   [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
  ; CHECK-NEXT:   [[PCOPY:%[0-9]+]]:gpr = PCOPY [[LDAbs1]]
  ; CHECK-NEXT:   CmpBrZero %bb.2, undef $z, 1, [[LDAbs]], implicit-def $c
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PCOPY1:%[0-9]+]]:gpr = PCOPY [[LDAbs]]
  ; CHECK-NEXT:   JMP %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[PCOPY]], %bb.0, [[PCOPY1]], %bb.1
  ; CHECK-NEXT:   [[PCOPY2:%[0-9]+]]:gpr = PCOPY [[PHI]]
  ; CHECK-NEXT:   STAbs [[PCOPY2]], 2000
  ; CHECK-NEXT:   RTS
  bb.0:
    successors: %bb.1, %bb.2
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    CmpBrZero %bb.2, undef $z, 1, %0, implicit-def $c
  bb.1:
    JMP %bb.2
  bb.2:
    %2:gpr = PHI %1, %bb.0, %0, %bb.1
    STAbs %2, 2000
    RTS
...
# One outgoing PCOPY serves both successors, including an indirect target.
---
name: indirect_successors
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: indirect_successors
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $rs0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
  ; CHECK-NEXT:   [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
  ; CHECK-NEXT:   [[PCOPY:%[0-9]+]]:gpr, [[PCOPY1:%[0-9]+]]:gpr = PCOPY [[LDAbs]], [[LDAbs1]]
  ; CHECK-NEXT:   JMPIndir $rs0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[PCOPY]], %bb.0
  ; CHECK-NEXT:   [[PCOPY2:%[0-9]+]]:gpr = PCOPY [[PHI]]
  ; CHECK-NEXT:   STAbs [[PCOPY2]], 2000
  ; CHECK-NEXT:   [[PCOPY3:%[0-9]+]]:gpr = PCOPY [[PCOPY2]]
  ; CHECK-NEXT:   JMP %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gpr = PHI [[PCOPY1]], %bb.0, [[PCOPY3]], %bb.1
  ; CHECK-NEXT:   [[PCOPY4:%[0-9]+]]:gpr = PCOPY [[PHI1]]
  ; CHECK-NEXT:   STAbs [[PCOPY4]], 2001
  ; CHECK-NEXT:   RTS
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rs0
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    JMPIndir $rs0
  bb.1:
    %2:gpr = PHI %0, %bb.0
    STAbs %2, 2000
    JMP %bb.2
  bb.2:
    %3:gpr = PHI %1, %bb.0, %2, %bb.1
    STAbs %3, 2001
    RTS
...
# Preserve subregister sources, undef inputs, and the original result's dead
# flag on the output copy.
---
name: operand_flags
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: operand_flags
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $rs0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:imag16 = COPY $rs0
  ; CHECK-NEXT:   [[PCOPY:%[0-9]+]]:imag8, [[PCOPY1:%[0-9]+]]:imag16 = PCOPY [[COPY]].sublo, undef %3:imag16
  ; CHECK-NEXT:   JMP %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:imag8 = PHI [[PCOPY]], %bb.0
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:imag16 = PHI [[PCOPY1]], %bb.0
  ; CHECK-NEXT:   [[PCOPY2:%[0-9]+]]:imag8, dead [[PCOPY3:%[0-9]+]]:imag16 = PCOPY [[PHI]], [[PHI1]]
  ; CHECK-NEXT:   $a = COPY [[PCOPY2]]
  ; CHECK-NEXT:   RTS implicit $a
  bb.0:
    liveins: $rs0
    %0:imag16 = COPY $rs0
    JMP %bb.1
  bb.1:
    %1:imag8 = PHI %0.sublo, %bb.0
    dead %2:imag16 = PHI undef %3:imag16, %bb.0
    $a = COPY %1
    RTS implicit $a
...
