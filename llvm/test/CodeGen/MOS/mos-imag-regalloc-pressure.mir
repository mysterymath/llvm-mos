# PHYSICAL-EARLY-CLOBBER-OVERFLOW: LLVM ERROR: MOSImagRegAlloc spill insertion is not implemented
---
name: physical_early_clobber_overflow
tracksRegLiveness: true
body: |
  bb.0:
    %0:imag16 = COPY $rs0
    %1:imag16 = COPY $rs0
    %2:imag16 = COPY $rs0
    %3:imag16 = COPY $rs0
    %4:imag16 = COPY $rs0
    %5:imag16 = COPY $rs0
    %6:imag16 = COPY $rs0
    %7:imag16 = COPY $rs0
    %8:imag16 = COPY $rs0
    %9:imag16 = COPY $rs0
    %10:imag16 = COPY $rs0
    %11:imag16 = COPY $rs0
    %12:imag16 = COPY $rs0
    %13:gpr = LDAbs 1000
    early-clobber $rs1 = STStk %13, $rs0, 0
    $rs0 = COPY %0
    $rs0 = COPY %1
    $rs0 = COPY %2
    $rs0 = COPY %3
    $rs0 = COPY %4
    $rs0 = COPY %5
    $rs0 = COPY %6
    $rs0 = COPY %7
    $rs0 = COPY %8
    $rs0 = COPY %9
    $rs0 = COPY %10
    $rs0 = COPY %11
    $rs0 = COPY %12
    RTS
...
