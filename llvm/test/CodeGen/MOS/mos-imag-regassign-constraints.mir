# Choose the global location outside RC2: restoring just before the branch
# must preserve both the physical condition and the value used by successors.
---
name: terminator_constraint
# ASSIGN-LABEL: name: terminator_constraint
# ASSIGN: isSSA: true
# ASSIGN: id: 0, {{.*}}assigned-phys: '$rc3'
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: terminator_constraint
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
  ; CHECK-NEXT:   $rc2 = COPY $rc0
  ; CHECK-NEXT:   CmpBrZero %bb.1, undef $z, 1, killed $rc2, implicit-def dead $c
  ; CHECK-NEXT:   JMP %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   STAbs killed [[LDAbs]], 2000
  ; CHECK-NEXT:   RTS
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   STAbs killed [[LDAbs]], 2001
  ; CHECK-NEXT:   RTS
  bb.0:
    successors: %bb.1, %bb.2
    %0:gpr = LDAbs 1000
    $rc2 = COPY $rc0
    CmpBrZero %bb.1, undef $z, 1, $rc2, implicit-def $c
    JMP %bb.2
  bb.1:
    STAbs %0, 2000
    RTS
  bb.2:
    STAbs %0, 2001
    RTS
...

# A displaced range used only in a successor temporarily has no uses until
# restoration is emitted. It must still occupy its local imaginary register.
---
name: live_through_split
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: live_through_split
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
  ; CHECK-NEXT:   [[PCOPY:%[0-9]+]]:gpr = PCOPY killed [[LDAbs]]
  ; CHECK-NEXT:   $rc2 = COPY $rc0
  ; CHECK-NEXT:   [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
  ; CHECK-NEXT:   STAbs killed [[LDAbs1]], 2000
  ; CHECK-NEXT:   $a = COPY killed $rc2
  ; CHECK-NEXT:   STAbs killed $a, 2001
  ; CHECK-NEXT:   [[PCOPY1:%[0-9]+]]:gpr = PCOPY killed [[PCOPY]]
  ; CHECK-NEXT:   JMP %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   STAbs killed [[PCOPY1]], 2002
  ; CHECK-NEXT:   RTS
  bb.0:
    successors: %bb.1
    %0:gpr = LDAbs 1000
    $rc2 = COPY $rc0
    %1:gpr = LDAbs 1001
    STAbs %1, 2000
    $a = COPY killed $rc2
    STAbs killed $a, 2001
    JMP %bb.1
  bb.1:
    STAbs %0, 2002
    RTS
...
