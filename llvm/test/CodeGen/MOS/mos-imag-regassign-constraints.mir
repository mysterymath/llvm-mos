# RUN: llc -mtriple=mos -run-pass=mos-spill,mos-imag-regassign -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=mos -run-pass=mos-spill,mos-imag-regassign -verify-machineinstrs %s -o %t
# RUN: FileCheck %s --check-prefix=ASSIGN --input-file=%t
# RUN: llc -mtriple=mos -run-pass=mos-spill,mos-imag-regassign,mos-regalloc -verify-machineinstrs %s -o /dev/null

# Preserve the original value without moving the fixed physical input.
---
name: preserve_physical_input
# ASSIGN-LABEL: name: preserve_physical_input
# ASSIGN: isSSA: true
# ASSIGN: id: 0, {{.*}}assigned-phys: '$rc2'
# ASSIGN: id: 1, {{.*}}assigned-phys: '$rc3'
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: preserve_physical_input
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: $rc2 = COPY [[LDAbs]]
    ; CHECK-NEXT: [[PCOPY:%[0-9]+]]:gpr = PCOPY killed [[LDAbs]]
    ; CHECK-NEXT: early-clobber $rc2 = IncMB $rc2(tied-def 0), implicit-def dead $c, implicit-def dead $v, implicit killed $rc2lsb
    ; CHECK-NEXT: $rc0 = COPY killed $rc2
    ; CHECK-NEXT: STAbs killed [[PCOPY]], 2000
    ; CHECK-NEXT: RTS
    %0:gpr = LDAbs 1000
    $rc2 = COPY %0
    early-clobber $rc2 = IncMB $rc2(tied-def 0), implicit-def $c, implicit-def $v
    $rc0 = COPY $rc2
    STAbs %0, 2000
    RTS
...

