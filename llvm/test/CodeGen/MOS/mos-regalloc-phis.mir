# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -run-pass=mos-imag-regalloc,mos-regalloc -verify-machineinstrs -o - %s | FileCheck %s

# The old PHI result remains live on the exit edge. Only the backedge may
# overwrite its backing register with the incremented value.
---
name: lost_copy
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: lost_copy
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $a = LDAbs 1000
  ; CHECK-NEXT:   $rc2 = STImag8 killed $a
  ; CHECK-NEXT:   JMP %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $rc2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x = LDImag8 $rc2
  ; CHECK-NEXT:   $x = IncMB killed $x(tied-def 0), implicit-def dead $c, implicit-def dead $v
  ; CHECK-NEXT:   $rc3 = STImag8 $x
  ; CHECK-NEXT:   CmpBrZero %bb.3, undef $z, 1, killed $x, implicit-def dead $c
  ; CHECK-NEXT:   JMP %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $rc2, $rc3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $a = LDImag8 killed $rc2
  ; CHECK-NEXT:   STAbs killed $a, 2000
  ; CHECK-NEXT:   $a = LDImag8 killed $rc3
  ; CHECK-NEXT:   STAbs killed $a, 2001
  ; CHECK-NEXT:   RTS
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $rc2, $rc3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $a = LDImag8 killed $rc2
  ; CHECK-NEXT:   dead $rc4 = STImag8 killed $a
  ; CHECK-NEXT:   $a = LDImag8 killed $rc3
  ; CHECK-NEXT:   $rc2 = STImag8 killed $a
  ; CHECK-NEXT:   JMP %bb.1
  bb.0:
    %0:gpr = LDAbs 1000
    JMP %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    %1:gpr = PHI %0, %bb.0, %2, %bb.1
    %2:gpr = IncMB %1(tied-def 0), implicit-def $c, implicit-def $v
    CmpBrZero %bb.1, undef $z, 1, %2, implicit-def $c
    JMP %bb.2
  bb.2:
    STAbs %1, 2000
    STAbs %2, 2001
    RTS
...
# The loop backedge exchanges the two PHI results. Preserve the first source
# before overwriting it, then read that saved value for the second destination.
---
name: swap
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: swap
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $a = LDAbs 1000
  ; CHECK-NEXT:   $x = LDAbs 1001
  ; CHECK-NEXT:   $rc2 = STImag8 killed $a
  ; CHECK-NEXT:   $rc3 = STImag8 killed $x
  ; CHECK-NEXT:   JMP %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $rc2, $rc3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x = LDImag8 $rc2
  ; CHECK-NEXT:   STAbs $x, 2000
  ; CHECK-NEXT:   $a = LDImag8 $rc3
  ; CHECK-NEXT:   STAbs killed $a, 2001
  ; CHECK-NEXT:   CmpBrZero %bb.3, undef $z, 1, killed $x, implicit-def dead $c
  ; CHECK-NEXT:   JMP %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RTS
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $rc2, $rc3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $a = LDImag8 killed $rc2
  ; CHECK-NEXT:   $rc4 = STImag8 killed $a
  ; CHECK-NEXT:   $a = LDImag8 killed $rc3
  ; CHECK-NEXT:   $rc2 = STImag8 killed $a
  ; CHECK-NEXT:   $a = LDImag8 killed $rc4
  ; CHECK-NEXT:   $rc3 = STImag8 killed $a
  ; CHECK-NEXT:   JMP %bb.1
  bb.0:
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    JMP %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    %2:gpr = PHI %0, %bb.0, %3, %bb.1
    %3:gpr = PHI %1, %bb.0, %2, %bb.1
    STAbs %2, 2000
    STAbs %3, 2001
    CmpBrZero %bb.1, undef $z, 1, %2, implicit-def $c
    JMP %bb.2
  bb.2:
    RTS
...
# This PHI transfer belongs to the taken critical edge, after the condition
# has been tested. The other path must retain the original value.
---
name: critical_edge
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: critical_edge
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $a = LDAbs 1000
  ; CHECK-NEXT:   $x = LDAbs 1001
  ; CHECK-NEXT:   $rc2 = STImag8 $a
  ; CHECK-NEXT:   $rc3 = STImag8 killed $x
  ; CHECK-NEXT:   CmpBrZero %bb.3, undef $z, 1, killed $a, implicit-def dead $c
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $rc2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   JMP %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $rc2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $a = LDImag8 killed $rc2
  ; CHECK-NEXT:   STAbs killed $a, 2000
  ; CHECK-NEXT:   RTS
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $rc2, $rc3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $a = LDImag8 killed $rc2
  ; CHECK-NEXT:   dead $rc4 = STImag8 killed $a
  ; CHECK-NEXT:   $a = LDImag8 killed $rc3
  ; CHECK-NEXT:   $rc2 = STImag8 killed $a
  ; CHECK-NEXT:   JMP %bb.2
  bb.0:
    successors: %bb.1, %bb.2
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    CmpBrZero %bb.2, undef $z, 1, %0, implicit-def $c
  bb.1:
    JMP %bb.2
  bb.2:
    %2:gpr = PHI %1, %bb.0, %0, %bb.1
    STAbs %2, 2000
    RTS
...
# The same requirement applies when the critical edge is a fallthrough.
# Splitting it must add a jump without changing the conditional branch target.
---
name: critical_fallthrough
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: critical_fallthrough
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.2(0x40000000)
