# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -run-pass=mos-spill,mos-imag-regassign,mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=mos -run-pass=processimpdefs,mos-conventional-ssa,mos-spill,mos-imag-regassign,mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=PROCESSED

# An IMPLICIT_DEF and its copies require neither storage nor materialization.
---
name: undef_copies
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: undef_copies
    ; CHECK: STAbs killed undef $a, 1000
    ; CHECK-NEXT: RTS
    ;
    ; PROCESSED-LABEL: name: undef_copies
    ; PROCESSED: STAbs undef $a, 1000
    ; PROCESSED-NEXT: RTS
    %0:gpr = IMPLICIT_DEF
    %1:gpr = COPY %0
    %2:gpr = COPY %1
    STAbs %2, 1000
    RTS
...

# Both an explicit undef operand and an IMPLICIT_DEF source leave the high
# byte unconstrained. Copying the pair must transfer only its defined low byte.
---
name: undef_components
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: undef_components
    ; CHECK: $a = LDAbs 1000
    ; CHECK-NEXT: dead $rc2 = STImag8 $a
    ; CHECK-NEXT: $rc0 = STImag8 $a
    ; CHECK-NEXT: $rc0 = STImag8 $a
    ; CHECK-NEXT: $rc0 = STImag8 killed $a
    ; CHECK-NEXT: RTS implicit $rs0
    ;
    ; PROCESSED-LABEL: name: undef_components
    ; PROCESSED: $a = LDAbs 1000
    ; PROCESSED-NEXT: dead $rc2 = STImag8 $a
    ; PROCESSED-NEXT: $rc0 = STImag8 $a
    ; PROCESSED-NEXT: $rc0 = STImag8 $a
    ; PROCESSED-NEXT: $rc0 = STImag8 killed $a
    ; PROCESSED-NEXT: RTS implicit $rs0
    %0:gpr = LDAbs 1000
    %1:gpr = IMPLICIT_DEF
    %2:imag16 = REG_SEQUENCE %0, %subreg.sublo, %1, %subreg.subhi
    %3:imag16 = COPY %2
    %4:imag16 = REG_SEQUENCE %0, %subreg.sublo, undef %5:gpr, %subreg.subhi
    $rs0 = COPY %2
    $rs0 = COPY %3
    $rs0 = COPY %4
    RTS implicit $rs0
...

# A completely undef pair can also be copied without producing either byte.
---
name: undef_pair
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: undef_pair
    ; CHECK: RTS implicit $rs0
    ;
    ; PROCESSED-LABEL: name: undef_pair
    ; PROCESSED: RTS implicit undef $rs0
    %0:gpr = IMPLICIT_DEF
    %1:imag16 = REG_SEQUENCE %0, %subreg.sublo, %0, %subreg.subhi
    %2:imag16 = COPY %1
    $rs0 = COPY %2
    RTS implicit $rs0
...

# An undef imaginary address needs an operand location, but no initialization.
# After ProcessImplicitDefs, the address operand has no SSA definition at all.
---
name: undef_address
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: undef_address
    ; CHECK: $a = LDIndir killed undef $rs1
    ; CHECK-NEXT: STAbs killed $a, 1000
    ; CHECK-NEXT: RTS
    ;
    ; PROCESSED-LABEL: name: undef_address
    ; PROCESSED: $a = LDIndir undef $rs0
    ; PROCESSED-NEXT: STAbs killed $a, 1000
    ; PROCESSED-NEXT: RTS
    %0:imag16 = IMPLICIT_DEF
    %1:ac = LDIndir %0
    STAbs %1, 1000
    RTS
...

# The tied input must use X, and its repeated undef use must use X too.
---
name: repeated_undef_use
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: repeated_undef_use
    ; CHECK: $x = INC undef $x, implicit undef $x
    ; CHECK-NEXT: STAbs killed $x, 1000
    ; CHECK-NEXT: RTS
    ;
    ; PROCESSED-LABEL: name: repeated_undef_use
    ; PROCESSED: $x = INC undef $x, implicit undef $x
    ; PROCESSED-NEXT: STAbs killed $x, 1000
    ; PROCESSED-NEXT: RTS
    %0:gpr = IMPLICIT_DEF
    $x = INC undef %0, implicit undef %0
    STAbs $x, 1000
    RTS
...

# An undef input still respects an early-clobber register exclusion.
---
name: early_clobber_undef_use
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: early_clobber_undef_use
    ; CHECK: early-clobber $a = LDAbs 1000, implicit undef $x
    ; CHECK-NEXT: STAbs killed $a, 1001
    ; CHECK-NEXT: RTS
    ;
    ; PROCESSED-LABEL: name: early_clobber_undef_use
    ; PROCESSED: early-clobber $y = LDAbs 1000, implicit undef $a
    ; PROCESSED-NEXT: STAbs killed $y, 1001
    ; PROCESSED-NEXT: RTS
    %0:gpr = IMPLICIT_DEF
    early-clobber %1:gpr = LDAbs 1000, implicit undef %0
    STAbs %1, 1001
    RTS
...
