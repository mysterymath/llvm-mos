# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -run-pass=mos-imag-regassign -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=mos -run-pass=mos-imag-regassign -verify-machineinstrs %s -o %t
# RUN: FileCheck %s --check-prefix=ASSIGN --input-file=%t

# The repair moves the value out of RC2 before its physical
# definition, then restores its global assignment on the outgoing edge. The
# join's new PHI must inherit the same assignment from both incoming paths.
---
name: physical_definition
# Assignment checks are handwritten; instruction checks use the MIR updater.
# ASSIGN-LABEL: name: physical_definition
# ASSIGN: isSSA: true
# ASSIGN: id: 0, {{.*}}assigned-phys: '$rc2'
# ASSIGN: id: 1, {{.*}}assigned-phys: '$rc3'
# ASSIGN: id: 2, {{.*}}assigned-phys: '$rc2'
# ASSIGN: id: 3, {{.*}}assigned-phys: '$rc2'
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
body: |
  ; CHECK-LABEL: name: physical_definition
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
  ; CHECK-NEXT:   CmpBrZero %bb.1, undef $z, 1, [[LDAbs]], implicit-def dead $c
  ; CHECK-NEXT:   JMP %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PCOPY:%[0-9]+]]:gpr = PCOPY killed [[LDAbs]]
  ; CHECK-NEXT:   $rc2 = COPY $rc0
  ; CHECK-NEXT:   $a = COPY killed $rc2
  ; CHECK-NEXT:   STAbs killed $a, 1001
  ; CHECK-NEXT:   [[PCOPY1:%[0-9]+]]:gpr = PCOPY killed [[PCOPY]]
  ; CHECK-NEXT:   JMP %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[LDAbs]], %bb.0, [[PCOPY1]], %bb.1
  ; CHECK-NEXT:   STAbs killed [[PHI]], 1002
  ; CHECK-NEXT:   RTS
  bb.0:
    successors: %bb.1, %bb.2
    %0:gpr = LDAbs 1000
    CmpBrZero %bb.1, undef $z, 1, %0, implicit-def $c
    JMP %bb.2

  bb.1:
    successors: %bb.2
    $rc2 = COPY $rc0
    $a = COPY killed $rc2
    STAbs killed $a, 1001
    JMP %bb.2

  bb.2:
    STAbs %0, 1002
    RTS
...

# The first tied input remains live after the operation. Its killed local copy
# shares an imaginary register with the result; the original value retains its
# own imaginary register.
---
name: live_through_tie
# ASSIGN-LABEL: name: live_through_tie
# ASSIGN: isSSA: true
# ASSIGN: id: 0, {{.*}}assigned-phys: '$rc2'
# ASSIGN: id: 2, {{.*}}assigned-phys: '$rc3'
# ASSIGN: id: 3, {{.*}}assigned-phys: '$rc4'
# ASSIGN: id: 4, {{.*}}assigned-phys: '$rc3'
# ASSIGN: id: 5, {{.*}}assigned-phys: '$rc4'
tracksRegLiveness: true
registers:
  - { id: 0, class: anyi8 }
  - { id: 1, class: anyi8 }
  - { id: 2, class: anyi8 }
  - { id: 3, class: anyi8 }
body: |
  bb.0:
    ; CHECK-LABEL: name: live_through_tie
    ; CHECK: [[COPY:%[0-9]+]]:anyi8 = COPY $rc0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:anyi8 = COPY $rc1
    ; CHECK-NEXT: [[PCOPY:%[0-9]+]]:anyi8, [[PCOPY1:%[0-9]+]]:anyi8 = PCOPY [[COPY]], killed [[COPY1]]
    ; CHECK-NEXT: [[IncMB:%[0-9]+]]:anyi8, [[IncMB1:%[0-9]+]]:anyi8 = IncMB killed [[PCOPY]](tied-def 0), killed [[PCOPY1]](tied-def 1), implicit-def dead $c, implicit-def dead $v
    ; CHECK-NEXT: $rc0 = COPY killed [[COPY]]
    ; CHECK-NEXT: $rc0 = COPY killed [[IncMB]]
    ; CHECK-NEXT: $rc1 = COPY killed [[IncMB1]]
    ; CHECK-NEXT: RTS
    %0:anyi8 = COPY $rc0
    %1:anyi8 = COPY $rc1
    %2:anyi8, %3:anyi8 = IncMB %0(tied-def 0), %1(tied-def 1), implicit-def $c, implicit-def $v
    $rc0 = COPY %0
    $rc0 = COPY %2
    $rc1 = COPY %3
    RTS
...

# An INC reuses its input's temporary location. Its result gets a separate SSA
# name for restoration; later definitions can prefer a globally and locally
# a free imaginary register rather than displacing the INC result again.
---
name: local_definition
# ASSIGN-LABEL: name: local_definition
# ASSIGN: isSSA: true
# ASSIGN: id: 0, {{.*}}assigned-phys: '$rc2'
# ASSIGN: id: 1, {{.*}}assigned-phys: '$rc3'
# ASSIGN: id: 2, {{.*}}assigned-phys: '$rc4'
# ASSIGN: id: 3, {{.*}}assigned-phys: '$rc3'
# ASSIGN: id: 4, {{.*}}assigned-phys: '$rc2'
tracksRegLiveness: true
registers:
  - { id: 0, class: anyi8 }
  - { id: 1, class: anyi8 }
  - { id: 2, class: gpr }
body: |
  ; CHECK-LABEL: name: local_definition
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:anyi8 = COPY $rc0
  ; CHECK-NEXT:   [[PCOPY:%[0-9]+]]:anyi8 = PCOPY killed [[COPY]]
  ; CHECK-NEXT:   $rc2 = COPY $rc1
  ; CHECK-NEXT:   $a = COPY killed $rc2
  ; CHECK-NEXT:   STAbs killed $a, 2000
  ; CHECK-NEXT:   [[INC:%[0-9]+]]:anyi8 = INC killed [[PCOPY]]
  ; CHECK-NEXT:   [[LDAbs:%[0-9]+]]:gpr = LDAbs 2001
  ; CHECK-NEXT:   STAbs killed [[LDAbs]], 2002
  ; CHECK-NEXT:   [[PCOPY1:%[0-9]+]]:anyi8 = PCOPY killed [[INC]]
  ; CHECK-NEXT:   JMP %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $a = COPY killed [[PCOPY1]]
  ; CHECK-NEXT:   STAbs killed $a, 2003
  ; CHECK-NEXT:   RTS
  bb.0:
    %0:anyi8 = COPY $rc0
    $rc2 = COPY $rc1
    $a = COPY killed $rc2
    STAbs killed $a, 2000
    %1:anyi8 = INC killed %0
    %2:gpr = LDAbs 2001
    STAbs killed %2, 2002
    JMP %bb.1

  bb.1:
    $a = COPY killed %1
    STAbs killed $a, 2003
    RTS
...

# Two successive moves must update local uses and carry the restoration
# obligation even after the final local use. Repairing the outgoing uses adds
# a PHI to the already visited loop header and updates its liveness snapshot.
---
name: repeated_loop_repairs
# ASSIGN-LABEL: name: repeated_loop_repairs
# ASSIGN: id: 0, {{.*}}assigned-phys: '$rc2'
# ASSIGN: id: 1, {{.*}}assigned-phys: '$rc3'
# ASSIGN: id: 2, {{.*}}assigned-phys: '$rc4'
# ASSIGN: id: 3, {{.*}}assigned-phys: '$rc2'
# ASSIGN: id: 4, {{.*}}assigned-phys: '$rc2'
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: repeated_loop_repairs
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
  ; CHECK-NEXT:   JMP %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[LDAbs]], %bb.0, %3, %bb.2
  ; CHECK-NEXT:   STAbs [[PHI]], 1999
  ; CHECK-NEXT:   JMP %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PCOPY:%[0-9]+]]:gpr = PCOPY killed [[PHI]]
  ; CHECK-NEXT:   $rc2 = COPY $rc0
  ; CHECK-NEXT:   STAbs [[PCOPY]], 2000
  ; CHECK-NEXT:   [[PCOPY1:%[0-9]+]]:gpr = PCOPY killed [[PCOPY]]
  ; CHECK-NEXT:   $rc3 = COPY $rc1
  ; CHECK-NEXT:   $a = COPY killed $rc2
  ; CHECK-NEXT:   STAbs killed $a, 2001
  ; CHECK-NEXT:   $a = COPY killed $rc3
  ; CHECK-NEXT:   [[PCOPY2:%[0-9]+]]:gpr = PCOPY killed [[PCOPY1]]
  ; CHECK-NEXT:   CmpBrZero %bb.1, undef $z, 1, killed $a, implicit-def dead $c
  ; CHECK-NEXT:   JMP %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   STAbs killed [[PCOPY2]], 2002
  ; CHECK-NEXT:   RTS
  bb.0:
    %0:gpr = LDAbs 1000
    JMP %bb.1

  bb.1:
    STAbs %0, 1999
    JMP %bb.2

  bb.2:
    $rc2 = COPY $rc0
    STAbs %0, 2000
    $rc3 = COPY $rc1
    $a = COPY killed $rc2
    STAbs killed $a, 2001
    $a = COPY killed $rc3
    CmpBrZero %bb.1, undef $z, 1, killed $a, implicit-def $c
    JMP %bb.3

  bb.3:
    STAbs %0, 2002
    RTS
...
