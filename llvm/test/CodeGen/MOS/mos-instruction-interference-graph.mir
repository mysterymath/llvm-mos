# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -stress-regalloc=2 -run-pass=mos-spill,mos-imag-regassign -verify-machineinstrs %s -o - | FileCheck %s

# Across the COPY, the dying source and its result both interfere with the
# live-through value, but not with each other. This path is two-colorable by
# simplification, although the middle node initially has two blockers.
---
name: simplify_path
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: simplify_path
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY killed [[LDAbs]]
    ; CHECK-NEXT: STAbs killed [[LDAbs1]], 2000
    ; CHECK-NEXT: STAbs killed [[COPY]], 2001
    ; CHECK-NEXT: RTS
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    %2:gpr = COPY %0
    STAbs %1, 2000
    STAbs %2, 2001
    RTS
...

# Renumbering the same graph must not change whether simplification succeeds.
---
name: renumbered_path
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: renumbered_path
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY killed [[LDAbs]]
    ; CHECK-NEXT: STAbs killed [[LDAbs1]], 2000
    ; CHECK-NEXT: STAbs killed [[COPY]], 2001
    ; CHECK-NEXT: RTS
    %9:gpr = LDAbs 1000
    %8:gpr = LDAbs 1001
    %0:gpr = COPY %9
    STAbs %8, 2000
    STAbs %0, 2001
    RTS
...
