# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=mos -run-pass=mos-regalloc -o - %s | FileCheck %s

---
name: gpr_conflict
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: gpr_conflict
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: $x = LDImm 2
    ; CHECK-NEXT: $y = LDImm 3
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $x, implicit killed $y
    %0:gpr = LDImm 1
    %1:gpr = LDImm 2
    %2:gpr = LDImm 3
    $a = COPY %0
    $x = COPY %1
    $y = COPY %2
    RTS implicit $a, implicit $x, implicit $y
...

---
name: no_overlap
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: no_overlap
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: $a = LDImm 2
    ; CHECK-NEXT: RTS implicit killed $a
    %0:gpr = LDImm 1
    $a = COPY %0
    %1:gpr = LDImm 2
    $a = COPY %1
    RTS implicit $a
...

---
name: overlapping_classes
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a
    ; %0's def class is Ac (COPY has no fixed class, so declared Ac is
    ; used). %1's def class is GPR (LDImm). Both alive simultaneously
    ; — %1 must avoid A since %0 occupies it.
    ; CHECK-LABEL: name: overlapping_classes
    ; CHECK: liveins: $a
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x = LDImm 2
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $x
    %0:ac = COPY $a
    %1:gpr = LDImm 2
    $a = COPY %0
    $x = COPY %1
    RTS implicit $a, implicit $x
...

