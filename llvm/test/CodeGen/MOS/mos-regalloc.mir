# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -run-pass=mos-imag-regalloc,mos-regalloc -verify-machineinstrs -o - %s | FileCheck %s
---
name: simple_load_store
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: simple_load_store
    ; CHECK: $a = LDAbs 1234
    ; CHECK-NEXT: STAbs killed $a, 4567
    %0:gpr = LDAbs 1234
    STAbs killed %0, 4567
...

# COPY aliases may share contents while their SSA live ranges overlap.
---
name: copy_aliases
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: ac }
body: |
  bb.0:
    ; CHECK-LABEL: name: copy_aliases
    ; CHECK: $a = LDAbs 1000
    ; CHECK-NEXT: STAbs $a, 2000
    ; CHECK-NEXT: STAbs killed $a, 3000
    %0:gpr = LDAbs 1000
    %1:ac = COPY %0
    STAbs %1, 2000
    STAbs %0, 3000
...

# A chain of COPYs retains the same value number across operand classes.
---
name: copy_chain
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: ac }
body: |
  bb.0:
    ; CHECK-LABEL: name: copy_chain
    ; CHECK: $a = LDAbs 1000
    ; CHECK-NEXT: STAbs $a, 3000
    ; CHECK-NEXT: STAbs $a, 4000
    ; CHECK-NEXT: STAbs killed $a, 5000
    %0:gpr = LDAbs 1000
    %1:gpr = COPY %0
    %2:ac  = COPY %0
    STAbs killed %2, 3000
    STAbs killed %0, 4000
    STAbs killed %1, 5000
...

---
name: livein
