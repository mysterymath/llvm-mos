# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -run-pass=mos-regalloc -o - %s | FileCheck %s
---
name: simple_load_store
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: simple_load_store
    ; CHECK: $a = LDAbs 1234
    ; CHECK-NEXT: STAbs killed $a, 4567
    %0:gpr = LDAbs 1234
    STAbs killed %0, 4567
...

# Narrowing: COPY %0 defines %1:Ac while %0:GPR is still live (non-kill use).
# GPR overlaps Ac (both contain A), so %0's effective class is narrowed
# from {A,X,Y} to {X,Y} to prove colorability.
---
name: narrowing
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: ac }
body: |
  bb.0:
    ; CHECK-LABEL: name: narrowing
    ; CHECK: $x = LDAbs 1000
    ; CHECK-NEXT: $a = COPY $x
    ; CHECK-NEXT: STAbs killed $x, 3000
    ; CHECK-NEXT: STAbs killed $a, 2000
    %0:gpr = LDAbs 1000
    %1:ac = COPY %0
    STAbs %1, 2000
    STAbs %0, 3000
...

# Multi-round narrowing: when %2:Ac is defined, both %0:GPR and %1:GPR are
# still live. Each contributes 1 to %2's interference (Σ=2, |Ac.Eff|=1, slack
# = -1). Narrowing one GPR off A is not enough — slack rises to 0; a second
# GPR must be narrowed for slack to reach 1.
---
name: chained_narrowing
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: ac }
body: |
  bb.0:
    ; CHECK-LABEL: name: chained_narrowing
    ; CHECK: $x = LDAbs 1000
    ; CHECK-NEXT: $y = COPY $x
    ; CHECK-NEXT: $a = COPY $x
    ; CHECK-NEXT: STAbs killed $x, 4000
    ; CHECK-NEXT: STAbs killed $y, 5000
    ; CHECK-NEXT: STAbs killed $a, 3000
    %0:gpr = LDAbs 1000
    %1:gpr = COPY %0
    %2:ac  = COPY %0
    STAbs killed %2, 3000
    STAbs killed %0, 4000
    STAbs killed %1, 5000
...

# Livein: $a is live at MBB entry, COPY'd into %0:Ac. K_livein cluster
# publishes $a; the COPY's cluster merges with K_livein.
---
name: livein
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a
    ; CHECK-LABEL: name: livein
    ; CHECK: liveins: $a
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $a = COPY killed $a
    ; CHECK-NEXT: STAbs killed $a, 1000
    %0:ac = COPY $a
    STAbs killed %0, 1000
...

# Livein, non-first consumer: a non-livein-using instruction comes first;
# the livein use at I1 triggers the if-branch into an empty K_livein.
# Without K_livein.Range bookkeeping, K_livein would silently absorb I1
# but its Range would stay empty.
---
name: livein_non_first
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: ac }
body: |
  bb.0:
    liveins: $a
    ; CHECK-LABEL: name: livein_non_first
    ; CHECK: liveins: $a
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $a = COPY killed $a
    ; CHECK-NEXT: STAbs killed $a, 3000
    ; CHECK-NEXT: $a = LDAbs 1000
    ; CHECK-NEXT: STAbs killed $a, 2000
    %0:gpr = LDAbs 1000
    %1:ac = COPY $a
    STAbs killed %0, 2000
    STAbs killed %1, 3000
...

# Linearization: two independent load-store pairs share no def-use, so
# neither schedulePhysRegs nor scheduleVRegs merges them. The final
# linearize pass walks MBB in order and merges adjacent clusters.
---
name: linearize_disconnected
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: linearize_disconnected
    ; CHECK: $a = LDAbs 1000
    ; CHECK-NEXT: STAbs killed $a, 2000
    ; CHECK-NEXT: $a = LDAbs 3000
    ; CHECK-NEXT: STAbs killed $a, 4000
    %0:gpr = LDAbs 1000
    STAbs killed %0, 2000
    %1:gpr = LDAbs 3000
    STAbs killed %1, 4000
...

# Tied def: %0 is single-use; the tied def %1 inherits %0's physreg via
# look-through. normalizeTiedRegs leaves the tie untouched (matching
# classes, single use).
---
name: tied_def
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: tied_def
    ; CHECK: $a = LDAbs 1000
    ; CHECK-NEXT: $a = INC killed $a
    ; CHECK-NEXT: STAbs killed $a, 2000
    %0:gpr = LDAbs 1000
    %1:gpr = INC killed %0
    STAbs killed %1, 2000
...

# Tied chain: %0 → %1 → %2 share one slot via two chained ties. Verifies
# that tiedRoot resolves transitively (the second INC's tied use is %1, a
# tied def whose root is %0).
---
name: tied_chain
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: tied_chain
    ; CHECK: $a = LDAbs 1000
    ; CHECK-NEXT: $a = INC killed $a
    ; CHECK-NEXT: $a = INC killed $a
    ; CHECK-NEXT: STAbs killed $a, 2000
    %0:gpr = LDAbs 1000
    %1:gpr = INC killed %0
    %2:gpr = INC killed %1
    STAbs killed %2, 2000
...

# Tied multi-use: %0 has two uses, so normalizeTiedRegs inserts a save
# COPY before the INC. The COPY's def %3 owns the tied slot; %0 stays
# live for the unrelated store.
---
name: tied_multi_use
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: tied_multi_use
    ; CHECK: $a = LDAbs 1000
    ; CHECK-NEXT: STAbs killed $a, 2000
    ; CHECK-NEXT: $a = COPY killed $a
    ; CHECK-NEXT: $a = INC killed $a
    ; CHECK-NEXT: STAbs killed $a, 3000
    %0:gpr = LDAbs 1000
    %1:gpr = INC %0
    STAbs killed %0, 2000
    STAbs killed %1, 3000
...

# Dead solitary def: a whole instruction's only def is dead. The vreg's
# slot doesn't extend past MI, so the following load reuses $a.
---
name: dead_def_solitary
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: dead_def_solitary
    ; CHECK: dead $a = LDAbs 1000
    ; CHECK-NEXT: $a = LDAbs 2000
    ; CHECK-NEXT: STAbs killed $a, 3000
    dead %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 2000
    STAbs killed %1, 3000
...

# Dead vreg def alongside a live def: ASL produces a live shifted value
# (tied to its input) and a carry output we don't care about. The dead
# carry vreg gets $c, but $c is freed after MI.
---
name: dead_def_with_live
tracksRegLiveness: true
registers:
  - { id: 0, class: ac }
  - { id: 1, class: ac }
  - { id: 2, class: cc }
body: |
  bb.0:
    ; CHECK-LABEL: name: dead_def_with_live
    ; CHECK: $a = LDAbs 1000
    ; CHECK-NEXT: $a, dead $c = ASL killed $a
    ; CHECK-NEXT: STAbs killed $a, 2000
    %0:ac = LDAbs 1000
    %1:ac, dead %2:cc = ASL killed %0
    STAbs killed %1, 2000
...

# Tied dead def: RORAbs writes memory with a rotate; its carryout is
# tied to carryin. Marking the carryout dead exercises the tiedRoot
# redirect in the dead-erase pass — the slot's root is the carryin
# vreg, not the dead def itself.
---
name: dead_def_tied
tracksRegLiveness: true
registers:
  - { id: 0, class: cc }
  - { id: 1, class: cc }
body: |
  bb.0:
    ; CHECK-LABEL: name: dead_def_tied
    ; CHECK: $c = LSRAbs 1000 :: (load (s8) from `ptr null`), (store (s8) into `ptr null`)
    ; CHECK-NEXT: dead $c = RORAbs 2000, killed $c :: (load (s8) from `ptr null`), (store (s8) into `ptr null`)
    %0:cc = LSRAbs 1000 :: (load (s8) from `ptr null`), (store (s8) into `ptr null`)
    dead %1:cc = RORAbs 2000, killed %0 :: (load (s8) from `ptr null`), (store (s8) into `ptr null`)
...
