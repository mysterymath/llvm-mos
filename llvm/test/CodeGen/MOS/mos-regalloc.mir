body: |
  bb.0:
    liveins: $a
    ; CHECK-LABEL: name: fixed_input_preservation
    ; CHECK: liveins: $a
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x = LDImm 5
    ; CHECK-NEXT: STAbs killed $x, 2000
    ; CHECK-NEXT: STAbs killed $a, 1000
    %0:ac = LDImm 5
    STAbs killed %0, 2000
    STAbs killed $a, 1000
...

# Capture both physical inputs before either can be overwritten.
---
