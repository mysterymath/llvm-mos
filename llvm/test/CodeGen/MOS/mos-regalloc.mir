    liveins: $a
    ; CHECK-LABEL: name: livein
    ; CHECK: liveins: $a
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: STAbs killed $a, 1000
    %0:ac = COPY $a
    STAbs killed %0, 1000
...

