    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x = LDAbs 1000
    ; CHECK-NEXT: STAbs killed $x, 2000
    ; CHECK-NEXT: STAbs killed $a, 3000
    %0:gpr = LDAbs 1000
    %1:ac = COPY $a
    STAbs killed %0, 2000
    STAbs killed %1, 3000
...

# Independent values can reuse storage after their last uses.
---
name: independent_values
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: independent_values
    ; CHECK: $a = LDAbs 1000
    ; CHECK-NEXT: STAbs killed $a, 2000
    ; CHECK-NEXT: $a = LDAbs 3000
    ; CHECK-NEXT: STAbs killed $a, 4000
    %0:gpr = LDAbs 1000
    STAbs killed %0, 2000
    %1:gpr = LDAbs 3000
    STAbs killed %1, 4000
...

