# A chain of COPYs retains the same value number across operand classes.
# Respect Ac uses without treating COPY aliases as distinct contents.
---
name: copy_chain_ac_constraints
tracksRegLiveness: true
registers:
  - { id: 0, class: ac }
  - { id: 1, class: gpr }
  - { id: 2, class: ac }
body: |
  bb.0:
    ; CHECK-LABEL: name: copy_chain_ac_constraints
    ; CHECK: $a = LDAbs 1000
    ; CHECK-NEXT: STAbs $a, 2000
    ; CHECK-NEXT: STAbs killed $a, 3000
    %0:ac = LDAbs 1000
    %1:gpr = COPY %0
    STAbs killed %0, 2000
    %2:ac = COPY killed %1
    STAbs killed %2, 3000
...

# Keep the input schedule while propagating equality through a COPY.
---
name: copy_triangle
tracksRegLiveness: true
registers:
  - { id: 0, class: ac }
  - { id: 1, class: xc }
body: |
  bb.0:
    ; CHECK-LABEL: name: copy_triangle
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: $x = TA $a
    ; CHECK-NEXT: STAbsIdx killed $a, 200, killed $x
    %0:ac = LDImm 1
    %1:xc = COPY %0
    STAbsIdx killed %0, 200, killed %1
...

