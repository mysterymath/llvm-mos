# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=mos -run-pass=mos-regalloc -o - %s | FileCheck %s

---
name: gpr_conflict
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: gpr_conflict
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: $x = LDImm 2
    ; CHECK-NEXT: $y = LDImm 3
    ; CHECK-NEXT: $a = COPY killed $a
    ; CHECK-NEXT: $x = COPY killed $x
    ; CHECK-NEXT: $y = COPY killed $y
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $x, implicit killed $y
    %0:gpr = LDImm 1
    %1:gpr = LDImm 2
    %2:gpr = LDImm 3
    $a = COPY %0
    $x = COPY %1
    $y = COPY %2
    RTS implicit $a, implicit $x, implicit $y
...

---
name: no_overlap
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: no_overlap
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: dead $a = COPY killed $a
    ; CHECK-NEXT: $a = LDImm 2
    ; CHECK-NEXT: $a = COPY killed $a
    ; CHECK-NEXT: RTS implicit killed $a
    %0:gpr = LDImm 1
    $a = COPY %0
    %1:gpr = LDImm 2
    $a = COPY %1
    RTS implicit $a
...

---
name: overlapping_classes
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: ac }
  - { id: 1, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: overlapping_classes
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: $x = LDImm 2
    ; CHECK-NEXT: $a = COPY killed $a
    ; CHECK-NEXT: $x = COPY killed $x
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $x
    %0:ac = LDImm 1
    %1:gpr = LDImm 2
    $a = COPY %0
    $x = COPY %1
    RTS implicit $a, implicit $x
...

---
name: phys_def_clobber
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: phys_def_clobber
    ; CHECK: $x = LDImm 1
    ; CHECK-NEXT: $a = LDImm 2
    ; CHECK-NEXT: $a = COPY killed $a
    ; CHECK-NEXT: $x = COPY killed $x
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $x
    %0:gpr = LDImm 1
    %1:gpr = LDImm 2
    $a = COPY %1
    $x = COPY %0
    RTS implicit $a, implicit $x
...

---
name: regmask_clobber
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: regmask_clobber
    ; CHECK: $a = LDImm 42
    ; CHECK-NEXT: $rc20 = COPY killed $a
    ; CHECK-NEXT: JSR &fn, mos_csr, implicit-def dead $a, implicit-def dead $x
    ; CHECK-NEXT: $a = COPY killed $rc20
    ; CHECK-NEXT: RTS implicit killed $a
    %0:gpr = LDImm 42
    %1:anyi8 = COPY %0
    JSR &fn, mos_csr, implicit-def $a, implicit-def $x
    $a = COPY %1
    RTS implicit $a
...

# TODO: The following code paths are not yet tested because constructing
# failing tests requires patterns that are hard to produce without copy
# extension (M5). Revisit after M5:
#   - vreg-vreg interference (redundant with phys interference for M1-M3)
#   - tied operand EQ (solver picks same reg by coincidence)
#   - earlyclobber def interference with same-instruction uses
#   - undef operand skip (undef $z not in any allocatable class)
#   - classesCanOverlap check (performance optimization, not correctness)
#   - regmask PhysLive kill (redundant with implicit-defs on calls)
