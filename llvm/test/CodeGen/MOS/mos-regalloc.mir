...

# TODO: The following code paths are not yet tested:
#   - undef operand skip
#   - regmask PhysLive kill

#
# Validated by disabling: vreg-vreg interference (gpr_conflict fails),
# earlyclobber (earlyclobber test fails with scratch=A clobbering %0).

# Earlyclobber: LDImm16's GPR scratch is @earlyclobber, written before
# the instruction completes. A live GPR vreg must avoid the scratch
# register. Without earlyclobber interference, the solver could assign
# them to the same register, corrupting the live value.
---
name: earlyclobber
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: earlyclobber
    ; CHECK: $x = LDImm 2
    ; CHECK-NEXT: $rs1, dead early-clobber $a = LDImm16 42
    ; CHECK-NEXT: $a = LDImm 1
    ; CHECK-NEXT: $x = LDImag8 $rc2
    ; CHECK-NEXT: $rc0 = STImag8 $x
    ; CHECK-NEXT: $x = LDImag8 $rc3
    ; CHECK-NEXT: $rc1 = STImag8 $x
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $x, implicit $rs0
    %0:gpr = LDImm 1
    %1:gpr = LDImm 2
    %2:imag16, %3:gpr = LDImm16 42
    $a = COPY %0
    $x = COPY %1
    $rs0 = COPY %2
    RTS implicit $a, implicit $x, implicit $rs0
...

# M4: Copy extension tests

# Def copy: ANDImm constrains its output to Ac (register A), but the
# result must route around an obstacle — a second value that also needs
# A. Without the def-copy, the vreg is widened to Anyi8 but nothing
# bridges ANDImm's Ac output to the wider class, producing wrong code
# (the solver assigns the vreg to X/Y but ANDImm physically writes A).
# With the def-copy, a COPY after ANDImm moves the value out of A.
#
# Validated by disabling: def-copy insertion (CHECK lines fail because
# ANDImm's output is assigned to a register other than A).
---
name: def_copy
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: def_copy
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: $a = ANDImm killed $a, 42
    ; CHECK-NEXT: dead $c = CMPImm killed $a, 10
    ; CHECK-NEXT: $a = LDImm 2
    ; CHECK-NEXT: RTS implicit killed $a
    %0:ac = LDImm 1
    %1:ac = ANDImm %0, 42
    $a = LDImm 2
    dead %2:cc = CMPImm %1, 10
    RTS implicit $a
...

# Two vregs are both narrowed to Ac by the parser (due to tied operands
# on ANDImm/ADCImm), but they're live simultaneously. Without copy
# extension (widening to def class + load-move copies), both would
# need register A and the solver would fail. With copy extension, one
# vreg is widened to GPR and a copy to Ac is inserted before its use.
---
name: copy_forced
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: copy_forced
    ; CHECK: $x = LDImm 1
    ; CHECK-NEXT: $a = T_A $x
    ; CHECK-NEXT: $c = LDImm1 0
    ; CHECK-NEXT: $a, dead $c, dead $v = ADCImm killed $a, 42, killed $c
    ; CHECK-NEXT: $y = TA $a
    ; CHECK-NEXT: $a = LDImm 99
    ; CHECK-NEXT: $a = ANDImm killed $a, 42
    ; CHECK-NEXT: $x = COPY $a
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $x
    %0:ac = LDImm 1
    %1:ac = LDImm 99
    %2:ac = ANDImm %1, 42
    $a = COPY %2
    $x = COPY $a
    %3:cc = LDImm1 0
    %4:ac, %5:cc, %6:vc = ADCImm %0, 42, %3
    $a = COPY %4
    RTS implicit $a, implicit $x
...
# Copy with clobber vreg: two vregs both need Xc at different
# instructions. One gets X (direct), the other gets Y and needs a
# Y→X copy. On vanilla 6502, Y→X goes through A (TYA+TAX), and
# copyPhysReg creates a vreg in Ac for the intermediate. The clobber
# model assigns it to A.
---
name: copy_creates_vreg
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: copy_creates_vreg
    ; CHECK: $x = LDImm 1
    ; CHECK-NEXT: dead $c = ASLIdx 42, killed $x
    ; CHECK-NEXT: $x = LDImm 2
    ; CHECK-NEXT: dead $c = ASLIdx 43, killed $x
    ; CHECK-NEXT: RTS
    %0:xc = LDImm 1
    %1:xc = LDImm 2
    %2:cc = ASLIdx 42, %0
    %3:cc = ASLIdx 43, %1
    RTS
...
# vreg→physreg cost: %0:gpr is copied to $x. The optimizer should
# assign %0=X (cost 0, COPY elided) rather than %0=A (cost TAX).
---
name: cost_vreg_to_phys
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: cost_vreg_to_phys
    ; CHECK: $x = LDImm 1
    ; CHECK-NEXT: RTS implicit killed $x
    %0:gpr = LDImm 1
    $x = COPY %0
    RTS implicit $x
...
# physreg→vreg cost: %0:gpr copies from $y, then is used by CMPImm
# (which takes GPR, no narrowing). Without optimization, VAL_MIN
# picks %0=A, so COPY $y expands to TYA. With optimization, %0=Y
# is free (COPY elided).
---
name: cost_phys_to_vreg
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $y
    ; CHECK-LABEL: name: cost_phys_to_vreg
    ; CHECK: liveins: $y
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: dead $c = CMPImm killed $y, 42
    ; CHECK-NEXT: RTS
    %0:gpr = COPY $y
    %1:cc = CMPImm %0, 42
    RTS
...

# Scheduling + constraint-based interference: %0 and %1 both need Xc.
# In the original order they are live simultaneously, forcing one to Y
# with an expensive Y→X copy. With reordering + constraint-based
# interference, the solver interleaves def/use pairs so only one Xc
# value is live at a time, and both can use X sequentially.
#
# Validated by disabling: constraint-based interference (backward walk
# treats %0 and %1 as simultaneously live, forcing the expensive copy).
---
name: scheduling_reorder
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: scheduling_reorder
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: $x = TA $a
    ; CHECK-NEXT: $a = LDImm 2
    ; CHECK-NEXT: dead $c = ASLIdx 42, killed $x
    ; CHECK-NEXT: dead $c = ASLIdx 43, killed $x
    ; CHECK-NEXT: $a = LDImm 0
    ; CHECK-NEXT: RTS implicit killed $a
    $a = LDImm 0
    %0:xc = LDImm 1
    %1:xc = LDImm 2
    dead %2:cc = ASLIdx 42, %0
    dead %3:cc = ASLIdx 43, %1
    RTS implicit $a
...
