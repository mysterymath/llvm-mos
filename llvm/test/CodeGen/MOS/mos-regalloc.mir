# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=mos -run-pass=mos-regalloc -o - %s | FileCheck %s

# Three GPR vregs live simultaneously must get distinct registers.
---
name: gpr_conflict
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: gpr_conflict
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: $x = LDImm 2
    ; CHECK-NEXT: $y = LDImm 3
    ; CHECK-NEXT: $a = COPY killed $a
    ; CHECK-NEXT: $x = COPY killed $x
    ; CHECK-NEXT: $y = COPY killed $y
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $x, implicit killed $y
    %0:gpr = LDImm 1
    %1:gpr = LDImm 2
    %2:gpr = LDImm 3
    $a = COPY %0
    $x = COPY %1
    $y = COPY %2
    RTS implicit $a, implicit $x, implicit $y
...

# Non-overlapping live ranges can share a register.
# %0 is dead before %1 is defined.
---
name: no_overlap
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: no_overlap
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: dead $a = COPY killed $a
    ; CHECK-NEXT: $a = LDImm 2
    ; CHECK-NEXT: $a = COPY killed $a
    ; CHECK-NEXT: RTS implicit killed $a
    %0:gpr = LDImm 1
    $a = COPY %0
    %1:gpr = LDImm 2
    $a = COPY %1
    RTS implicit $a
...

# Different non-overlapping classes (ac vs cc) don't interfere.
---
name: disjoint_classes
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: ac }
  - { id: 1, class: cc }
  - { id: 2, class: vc }
body: |
  bb.0:
    ; CHECK-LABEL: name: disjoint_classes
    ; CHECK: $a = LDImm 42
    ; CHECK-NEXT: $c = LDImm1 0
    ; CHECK-NEXT: $v = LDImm1 0
    ; CHECK-NEXT: $a = COPY killed $a
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $c, implicit killed $v
    %0:ac = LDImm 42
    %1:cc = LDImm1 0
    %2:vc = LDImm1 0
    $a = COPY %0
    RTS implicit $a, implicit %1, implicit %2
...

# Overlapping classes: ac and gpr both contain A.
# If live simultaneously, the ac vreg gets A and the gpr vreg
# must pick X or Y.
---
name: overlapping_classes
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: ac }
  - { id: 1, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: overlapping_classes
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: $x = LDImm 2
    ; CHECK-NEXT: $a = COPY killed $a
    ; CHECK-NEXT: $x = COPY killed $x
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $x
    %0:ac = LDImm 1
    %1:gpr = LDImm 2
    $a = COPY %0
    $x = COPY %1
    RTS implicit $a, implicit $x
...

# Dead def: %0 is defined but never used. Should still be allocated
# but shouldn't block anything.
---
name: dead_def
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: dead_def
    ; CHECK: dead $a = LDImm 1
    ; CHECK-NEXT: $a = LDImm 2
    ; CHECK-NEXT: $a = COPY killed $a
    ; CHECK-NEXT: RTS implicit killed $a
    %0:gpr = LDImm 1
    %1:gpr = LDImm 2
    $a = COPY %1
    RTS implicit $a
...
