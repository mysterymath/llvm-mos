# A tied update must preserve its input for a later, independent use.
---
name: tied_multi_use
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
body: |
  bb.0:
    ; CHECK-LABEL: name: tied_multi_use
    ; CHECK: $a = LDAbs 1000
    ; CHECK-NEXT: $x = TA $a
    ; CHECK-NEXT: $x = INC killed $x
    ; CHECK-NEXT: STAbs killed $a, 2000
    ; CHECK-NEXT: STAbs killed $x, 3000
    %0:gpr = LDAbs 1000
    %1:gpr = INC %0
    STAbs killed %0, 2000
    STAbs killed %1, 3000
...

