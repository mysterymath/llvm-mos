# TODO: The following code paths are not yet tested:
#   - undef operand skip
#   - regmask PhysLive kill

#
# Validated by disabling: vreg-vreg interference (gpr_conflict fails),
# earlyclobber (earlyclobber test fails with scratch=A clobbering %0).

# Earlyclobber: LDImm16's GPR scratch is @earlyclobber, written before
# the instruction completes. A live GPR vreg must avoid the scratch
# register. Without earlyclobber interference, the solver could assign
# them to the same register, corrupting the live value.
---
name: earlyclobber
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: earlyclobber
    ; CHECK: $a = LDImm 1
    ; CHECK-NEXT: $x = LDImm 2
    ; CHECK-NEXT: $rs1, dead early-clobber $y = LDImm16 42
    ; CHECK-NEXT: $a = COPY killed $a
    ; CHECK-NEXT: $x = COPY killed $x
    ; CHECK-NEXT: $rs0 = COPY killed $rs1
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $x, implicit $rs0
    %0:gpr = LDImm 1
    %1:gpr = LDImm 2
    %2:imag16, %3:gpr = LDImm16 42
    $a = COPY %0
    $x = COPY %1
    $rs0 = COPY %2
    RTS implicit $a, implicit $x, implicit $rs0

# M4: Copy extension tests

# Two vregs are both narrowed to Ac by the parser (due to tied operands
# on ANDImm/ADCImm), but they're live simultaneously. Without copy
# extension (widening to def class + load-move copies), both would
# need register A and the solver would fail. With copy extension, one
# vreg is widened to GPR and a copy to Ac is inserted before its use.
---
name: copy_forced
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
body: |
  bb.0:
    %0:ac = LDImm 1
    %5:ac = LDImm 99
    %6:ac = ANDImm %5, 42
    $a = COPY %6
    $x = COPY $a
    %1:cc = LDImm1 0
    %2:ac, %3:cc, %4:vc = ADCImm %0, 42, %1
    $a = COPY %2
    RTS implicit $a, implicit $x
...
# Copy with clobber vreg: two vregs both need Xc at different
# instructions. One gets X (direct), the other gets Y and needs a
# Y→X copy. On vanilla 6502, Y→X goes through A (TYA+TAX), and
# copyPhysReg creates a vreg in Ac for the intermediate. The clobber
# model assigns it to A.
---
name: copy_creates_vreg
legalized: true
regBankSelected: true
selected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: copy_creates_vreg
    ; CHECK: $x = LDImm 1
    ; CHECK-NEXT: $a = LDImm 2
    ; CHECK-NEXT: dead $c = ASLIdx 42, killed $x
    ; CHECK-NEXT: $x = TA $a
    ; CHECK-NEXT: dead $c = ASLIdx 43, killed $x
    ; CHECK-NEXT: RTS
    %0:xc = LDImm 1
    %1:xc = LDImm 2
    %2:cc = ASLIdx 42, %0
    %3:cc = ASLIdx 43, %1
    RTS
...
