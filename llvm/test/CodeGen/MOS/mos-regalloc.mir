tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a, $x
    ; CHECK-LABEL: name: two_liveins
    ; CHECK: liveins: $a, $x
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: STAbs killed $a, 1000
    ; CHECK-NEXT: STAbs killed $x, 2000
    %0:gpr = COPY $a
    %1:gpr = COPY $x
    STAbs killed %0, 1000
    STAbs killed %1, 2000
...

# Place both return values in their required physical registers.
---
name: two_return_values
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: two_return_values
    ; CHECK: $x = LDAbs 1000
    ; CHECK-NEXT: $a = LDAbs 2000
    ; CHECK-NEXT: RTS implicit killed $a, implicit killed $x
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 2000
    $x = COPY %0
    $a = COPY %1
    RTS implicit $a, implicit $x
...

# Physical COPYs are instructions to retain, even in a function with SSA values.
---
name: physical_copy_before_capture
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x
    ; CHECK-LABEL: name: physical_copy_before_capture
    ; CHECK: liveins: $x
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $a = COPY killed $x
    ; CHECK-NEXT: STAbs killed $a, 1000
    ; CHECK-NEXT: RTS
    $a = COPY $x
    %0:ac = COPY $a
    STAbs %0, 1000
    RTS
...

# Fixed definitions may include overlapping implicit aliases.
---
name: overlapping_phys_defs
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: overlapping_phys_defs
    ; CHECK: JSR &callee, mos_csr, implicit-def $rs1, implicit-def $rc2
    ; CHECK-NEXT: $a = LDImag8 killed $rc2
    ; CHECK-NEXT: $rc4 = STImag8 killed $a
    ; CHECK-NEXT: $a = LDImag8 killed $rc3
    ; CHECK-NEXT: $rc5 = STImag8 killed $a
    ; CHECK-NEXT: RTS implicit killed $rs2
    JSR &callee, mos_csr, implicit-def $rs1, implicit-def $rc2
    %0:imag16 = COPY $rs1
    $rs2 = COPY %0
    RTS implicit $rs2
...

# A tied early-clobber result may reuse its physical input. Other inputs remain
# protected from early-clobber definitions.
---
name: early_tied_phys_input
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x
    ; CHECK-LABEL: name: early_tied_phys_input
    ; CHECK: liveins: $x
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: early-clobber $x = IncMB killed $x(tied-def 0), implicit-def dead $c, implicit-def dead $v, implicit killed $xlsb
    ; CHECK-NEXT: STAbs killed $x, 1000
    ; CHECK-NEXT: RTS
    early-clobber %0:xc = IncMB $x(tied-def 0), implicit-def $c, implicit-def $v
    STAbs %0, 1000
    RTS
...
