    ; CHECK-NEXT: $rc20 = COPY killed $a
    ; CHECK-NEXT: JSR &fn, mos_csr, implicit-def dead $a, implicit-def dead $x
    ; CHECK-NEXT: $a = COPY killed $rc20
    ; CHECK-NEXT: RTS implicit killed $a
    %0:gpr = LDImm 42
    %1:anyi8 = COPY %0
