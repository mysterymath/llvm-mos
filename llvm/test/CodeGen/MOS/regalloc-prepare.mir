name: reg-sequence
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0.entry:
    ; CHECK-LABEL: name: reg-sequence
    ; CHECK: [[LDImm:%[0-9]+]]:gpr = LDImm 42
    ; CHECK-NEXT: [[INIT_UNDEF:%[0-9]+]]:imag16 = INIT_UNDEF
    ; CHECK-NEXT: [[INSERT_SUBREG:%[0-9]+]]:imag16 = INSERT_SUBREG [[INIT_UNDEF]], [[LDImm]], %subreg.subhi
    ; CHECK-NEXT: [[LDImm1:%[0-9]+]]:gpr = LDImm 43
    ; CHECK-NEXT: [[INSERT_SUBREG1:%[0-9]+]]:imag16 = INSERT_SUBREG [[INSERT_SUBREG]], [[LDImm1]], %subreg.sublo
    ; CHECK-NEXT: RTS implicit [[INSERT_SUBREG1]]
    %0:gpr = LDImm 42
    %1:gpr = LDImm 43
    %2:imag16 = REG_SEQUENCE %1, %subreg.sublo, %0, %subreg.subhi
    RTS implicit %2
...
