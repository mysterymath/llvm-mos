    $rs0 = COPY %1
    $rs0 = COPY %2
    RTS
...

# Copying the low byte onto itself preserves the pair. Copying the high byte
# over the low byte must first preserve the pair for the later low-byte use.
# Virtual extractions also share the identities of the physical COPY results.
---
name: physical_pair_projections
# ASSIGN-LABEL: name: physical_pair_projections
# ASSIGN: id: 5, {{.*}}assigned-phys: '$rc2'
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: physical_pair_projections
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; CHECK-NEXT: [[REG_SEQUENCE:%[0-9]+]]:imag16 = REG_SEQUENCE killed [[LDAbs]], %subreg.sublo, killed [[LDAbs1]], %subreg.subhi
    ; CHECK-NEXT: $rc2 = COPY [[REG_SEQUENCE]].sublo
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY [[REG_SEQUENCE]].sublo
    ; CHECK-NEXT: $a = COPY killed $rc2
    ; CHECK-NEXT: STAbs killed $a, 1002
    ; CHECK-NEXT: STAbs killed [[COPY]], 1003
    ; CHECK-NEXT: [[PCOPY:%[0-9]+]]:imag16 = PCOPY killed [[REG_SEQUENCE]]
    ; CHECK-NEXT: $rc2 = COPY [[PCOPY]].subhi
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY [[PCOPY]].sublo
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr = COPY killed [[PCOPY]].subhi
    ; CHECK-NEXT: $a = COPY killed $rc2
    ; CHECK-NEXT: STAbs killed $a, 1004
    ; CHECK-NEXT: STAbs killed [[COPY2]], 1005
    ; CHECK-NEXT: STAbs killed [[COPY1]], 1006
    ; CHECK-NEXT: RTS
    ;
    ; HW-LABEL: name: physical_pair_projections
    ; HW: $x = LDAbs 1000
    ; HW-NEXT: $y = LDAbs 1001
    ; HW-NEXT: $rc2 = STImag8 $x
    ; HW-NEXT: dead $rc3 = STImag8 $y
    ; HW-NEXT: $a = COPY killed $rc2
    ; HW-NEXT: STAbs killed $a, 1002
    ; HW-NEXT: STAbs $x, 1003
    ; HW-NEXT: $rc2 = STImag8 $y
    ; HW-NEXT: $a = COPY killed $rc2
    ; HW-NEXT: STAbs killed $a, 1004
    ; HW-NEXT: STAbs killed $y, 1005
    ; HW-NEXT: STAbs killed $x, 1006
    ; HW-NEXT: RTS
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    %2:imag16 = REG_SEQUENCE %0, %subreg.sublo, %1, %subreg.subhi
    $rc2 = COPY %2.sublo
    %3:gpr = COPY %2.sublo
    $a = COPY $rc2
