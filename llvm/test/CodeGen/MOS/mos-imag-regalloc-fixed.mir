    RTS
...

# Overwriting one byte of a fixed pair preserves the other byte's identity.
---
name: partial_fixed_value
# ASSIGN-LABEL: name: partial_fixed_value
# ASSIGN: id: 3, {{.*}}assigned-phys: '$rc3'
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: partial_fixed_value
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; CHECK-NEXT: [[REG_SEQUENCE:%[0-9]+]]:imag16 = REG_SEQUENCE killed [[LDAbs]], %subreg.sublo, [[LDAbs1]], %subreg.subhi
    ; CHECK-NEXT: dead $rs1 = COPY killed [[REG_SEQUENCE]], implicit-def $rc3
    ; CHECK-NEXT: JSR &overwrite_low, implicit-def $rc2
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY [[LDAbs1]]
    ; CHECK-NEXT: JSR &callee, implicit killed $rc2, implicit killed $rc3
    ; CHECK-NEXT: STAbs killed [[LDAbs1]], 2000
    ; CHECK-NEXT: STAbs killed [[COPY]], 2001
    ; CHECK-NEXT: RTS
    ;
    ; HW-LABEL: name: partial_fixed_value
    ; HW: $x = LDAbs 1000
    ; HW-NEXT: $y = LDAbs 1001
    ; HW-NEXT: dead $rc4 = STImag8 $x
    ; HW-NEXT: dead $rc5 = STImag8 $y
    ; HW-NEXT: dead $rc2 = STImag8 killed $x
    ; HW-NEXT: $rc3 = STImag8 $y
    ; HW-NEXT: JSR &overwrite_low, implicit-def $rc2
    ; HW-NEXT: JSR &callee, implicit killed $rc2, implicit killed $rc3
    ; HW-NEXT: STAbs $y, 2000
    ; HW-NEXT: STAbs killed $y, 2001
    ; HW-NEXT: RTS
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    %2:imag16 = REG_SEQUENCE %0, %subreg.sublo, %1, %subreg.subhi
    $rs1 = COPY %2
    JSR &overwrite_low, implicit-def $rc2
    %3:gpr = COPY %1
    JSR &callee, implicit $rc2, implicit $rc3
    STAbs %1, 2000
    STAbs %3, 2001
    RTS
...

# A whole value can share a fixed pair. After an opaque definition overwrites
# its low byte, that pair must no longer answer as containing the old value.
---
name: fixed_pair_overwrite
# ASSIGN-LABEL: name: fixed_pair_overwrite
# ASSIGN: id: 0, {{.*}}assigned-phys: '$rs1'
# ASSIGN: id: 1, {{.*}}assigned-phys: '$rs1'
# ASSIGN: id: 2, {{.*}}assigned-phys: '$rs2'
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: fixed_pair_overwrite
    ; CHECK: [[COPY:%[0-9]+]]:imag16 = COPY $rs0
    ; CHECK-NEXT: dead $rs1 = COPY [[COPY]], implicit-def $rc3
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:imag16 = COPY [[COPY]]
    ; CHECK-NEXT: [[PCOPY:%[0-9]+]]:imag16 = PCOPY killed [[COPY]]
    ; CHECK-NEXT: [[PCOPY1:%[0-9]+]]:imag16 = PCOPY killed [[COPY1]]
    ; CHECK-NEXT: JSR &overwrite_low, implicit-def $rc2
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:imag16 = COPY [[PCOPY]]
    ; CHECK-NEXT: JSR &callee, implicit killed $rc2, implicit killed $rc3
    ; CHECK-NEXT: $rs0 = COPY killed [[PCOPY]]
    ; CHECK-NEXT: $rs0 = COPY killed [[PCOPY1]]
    ; CHECK-NEXT: $rs0 = COPY killed [[COPY2]]
    ; CHECK-NEXT: RTS
    ;
    ; HW-LABEL: name: fixed_pair_overwrite
    ; HW: $a = LDImag8 $rc0
    ; HW-NEXT: $rc2 = STImag8 killed $a
    ; HW-NEXT: $a = LDImag8 $rc1
    ; HW-NEXT: $rc3 = STImag8 $a
    ; HW-NEXT: $x = LDImag8 killed $rc2
    ; HW-NEXT: dead $rc4 = STImag8 $x
    ; HW-NEXT: JSR &overwrite_low, implicit-def $rc2
    ; HW-NEXT: dead $rc5 = STImag8 $a
    ; HW-NEXT: JSR &callee, implicit killed $rc2, implicit killed $rc3
    ; HW-NEXT: $rc0 = STImag8 $x
    ; HW-NEXT: $rc1 = STImag8 $a
    ; HW-NEXT: $rc0 = STImag8 $x
    ; HW-NEXT: $rc1 = STImag8 $a
    ; HW-NEXT: $rc0 = STImag8 killed $x
    ; HW-NEXT: $rc1 = STImag8 killed $a
    ; HW-NEXT: RTS
    %0:imag16 = COPY $rs0
    $rs1 = COPY %0
    %1:imag16 = COPY %0
    JSR &overwrite_low, implicit-def $rc2
    %2:imag16 = COPY %0
    JSR &callee, implicit $rc2, implicit $rc3
