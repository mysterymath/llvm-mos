# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mos -run-pass=mos-imag-regalloc -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=mos -run-pass=mos-imag-regalloc,mos-regalloc -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=HW
# RUN: llc -mtriple=mos -run-pass=mos-imag-regalloc -verify-machineinstrs %s -o %t
# RUN: FileCheck %s --check-prefix=ASSIGN --input-file=%t

# The source already occupies the required location. Its physical copy must
# share that location without evacuating the source.
---
name: fixed_copy
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: fixed_copy
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: $rc2 = COPY [[LDAbs]]
    ; CHECK-NEXT: JSR &callee, implicit killed $rc2
    ; CHECK-NEXT: STAbs killed [[LDAbs]], 2000
    ; CHECK-NEXT: RTS
    ;
    ; HW-LABEL: name: fixed_copy
    ; HW: $a = LDAbs 1000
    ; HW-NEXT: $rc2 = STImag8 $a
    ; HW-NEXT: JSR &callee, implicit killed $rc2
    ; HW-NEXT: STAbs killed $a, 2000
    ; HW-NEXT: RTS
    %0:gpr = LDAbs 1000
    $rc2 = COPY %0
    JSR &callee, implicit $rc2
    STAbs %0, 2000
    RTS
...

# The physical lifetime continues after the virtual source dies. Its register
# becomes available to ordinary definitions only after the physical kill.
---
name: fixed_lifetime
# ASSIGN-LABEL: name: fixed_lifetime
# ASSIGN: id: 0, {{.*}}assigned-phys: '$rc2'
# ASSIGN: id: 1, {{.*}}assigned-phys: '$rc3'
# ASSIGN: id: 2, {{.*}}assigned-phys: '$rc2'
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: fixed_lifetime
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: $rc2 = COPY killed [[LDAbs]]
    ; CHECK-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; CHECK-NEXT: JSR &callee, implicit killed $rc2
    ; CHECK-NEXT: [[LDAbs2:%[0-9]+]]:gpr = LDAbs 1002
    ; CHECK-NEXT: STAbs killed [[LDAbs1]], 2001
    ; CHECK-NEXT: STAbs killed [[LDAbs2]], 2002
    ; CHECK-NEXT: RTS
    ;
    ; HW-LABEL: name: fixed_lifetime
    ; HW: $a = LDAbs 1000
    ; HW-NEXT: $rc2 = STImag8 killed $a
    ; HW-NEXT: $x = LDAbs 1001
    ; HW-NEXT: JSR &callee, implicit killed $rc2
    ; HW-NEXT: $a = LDAbs 1002
    ; HW-NEXT: STAbs killed $x, 2001
    ; HW-NEXT: STAbs killed $a, 2002
    ; HW-NEXT: RTS
    %0:gpr = LDAbs 1000
    $rc2 = COPY %0
    %1:gpr = LDAbs 1001
    JSR &callee, implicit $rc2
    %2:gpr = LDAbs 1002
    STAbs %1, 2001
    STAbs %2, 2002
    RTS
...

# A tied input dies virtually, but its physical copy must retain the old value.
# Give the tied operation a separate input and result location.
---
name: fixed_tied_input
# ASSIGN-LABEL: name: fixed_tied_input
# ASSIGN: id: 0, {{.*}}assigned-phys: '$rc2'
# ASSIGN: id: 1, {{.*}}assigned-phys: '$rc3'
# ASSIGN: id: 2, {{.*}}split-from: '%0',
# ASSIGN-NEXT: assigned-phys: '$rc3'
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: fixed_tied_input
    ; CHECK: [[COPY:%[0-9]+]]:anyi8 = COPY $rc0
    ; CHECK-NEXT: $rc2 = COPY [[COPY]]
    ; CHECK-NEXT: [[PCOPY:%[0-9]+]]:anyi8 = PCOPY killed [[COPY]]
    ; CHECK-NEXT: [[IncMB:%[0-9]+]]:anyi8 = IncMB killed [[PCOPY]](tied-def 0), implicit-def dead $c, implicit-def dead $v
    ; CHECK-NEXT: JSR &callee, implicit killed $rc2
    ; CHECK-NEXT: $a = COPY killed [[IncMB]]
    ; CHECK-NEXT: STAbs killed $a, 2000
    ; CHECK-NEXT: RTS
    ;
    ; HW-LABEL: name: fixed_tied_input
    ; HW: $y = LDImag8 $rc0
    ; HW-NEXT: $rc2 = STImag8 $y
    ; HW-NEXT: $y = IncMB killed $y(tied-def 0), implicit-def dead $c, implicit-def dead $v
    ; HW-NEXT: JSR &callee, implicit killed $rc2
    ; HW-NEXT: $a = T_A killed $y
    ; HW-NEXT: STAbs killed $a, 2000
    ; HW-NEXT: RTS
    %0:anyi8 = COPY $rc0
    $rc2 = COPY %0
    %1:anyi8 = IncMB %0(tied-def 0), implicit-def $c, implicit-def $v
    JSR &callee, implicit $rc2
    $a = COPY %1
    STAbs $a, 2000
    RTS
...

# Two overlapping physical lifetimes need two occurrences of the same value.
---
name: two_fixed_lifetimes
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: two_fixed_lifetimes
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: $rc2 = COPY [[LDAbs]]
    ; CHECK-NEXT: [[PCOPY:%[0-9]+]]:gpr = PCOPY [[LDAbs]]
    ; CHECK-NEXT: $rc3 = COPY killed [[PCOPY]]
    ; CHECK-NEXT: JSR &callee, implicit killed $rc2, implicit killed $rc3
    ; CHECK-NEXT: STAbs killed [[LDAbs]], 2000
    ; CHECK-NEXT: RTS
    ;
    ; HW-LABEL: name: two_fixed_lifetimes
    ; HW: $a = LDAbs 1000
    ; HW-NEXT: $rc2 = STImag8 $a
    ; HW-NEXT: $rc3 = STImag8 $a
    ; HW-NEXT: JSR &callee, implicit killed $rc2, implicit killed $rc3
    ; HW-NEXT: STAbs killed $a, 2000
    ; HW-NEXT: RTS
    %0:gpr = LDAbs 1000
    $rc2 = COPY %0
    $rc3 = COPY %0
    JSR &callee, implicit $rc2, implicit $rc3
    STAbs %0, 2000
    RTS
...

# The argument is consumed before the call clobber. Preserve the virtual value
# elsewhere while keeping the physical operand at its required location.
---
name: clobbered_argument
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: clobbered_argument
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: $rc2 = COPY [[LDAbs]]
    ; CHECK-NEXT: [[PCOPY:%[0-9]+]]:gpr = PCOPY killed [[LDAbs]]
    ; CHECK-NEXT: JSR &callee, mos_csr, implicit killed $rc2
    ; CHECK-NEXT: STAbs killed [[PCOPY]], 2000
    ; CHECK-NEXT: RTS
    ;
    ; HW-LABEL: name: clobbered_argument
    ; HW: $a = LDAbs 1000
    ; HW-NEXT: $rc2 = STImag8 $a
    ; HW-NEXT: $rc20 = STImag8 killed $a
    ; HW-NEXT: JSR &callee, mos_csr, implicit killed $rc2
    ; HW-NEXT: $a = LDImag8 killed $rc20
    ; HW-NEXT: STAbs killed $a, 2000
    ; HW-NEXT: RTS
    %0:gpr = LDAbs 1000
    $rc2 = COPY %0
    JSR &callee, mos_csr, implicit $rc2
    STAbs %0, 2000
    RTS
...

# The first fixed COPY exchanges two occupied backings. The second argument
# is then already in place; no scratch backing is needed for the exchange.
---
name: swap_arguments
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: swap_arguments
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: [[LDAbs1:%[0-9]+]]:gpr = LDAbs 1001
    ; CHECK-NEXT: [[PCOPY:%[0-9]+]]:gpr, [[PCOPY1:%[0-9]+]]:gpr = PCOPY killed [[LDAbs]], killed [[LDAbs1]]
    ; CHECK-NEXT: $rc2 = COPY [[PCOPY1]]
    ; CHECK-NEXT: $rc3 = COPY [[PCOPY]]
    ; CHECK-NEXT: JSR &callee, implicit killed $rc2, implicit killed $rc3
    ; CHECK-NEXT: STAbs killed [[PCOPY]], 2000
    ; CHECK-NEXT: STAbs killed [[PCOPY1]], 2001
    ; CHECK-NEXT: RTS
    ;
    ; HW-LABEL: name: swap_arguments
    ; HW: $a = LDAbs 1000
    ; HW-NEXT: $x = LDAbs 1001
    ; HW-NEXT: $rc2 = STImag8 $x
    ; HW-NEXT: $rc3 = STImag8 $a
    ; HW-NEXT: JSR &callee, implicit killed $rc2, implicit killed $rc3
    ; HW-NEXT: STAbs killed $a, 2000
    ; HW-NEXT: STAbs killed $x, 2001
    ; HW-NEXT: RTS
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    $rc2 = COPY %1
    $rc3 = COPY %0
    JSR &callee, implicit $rc2, implicit $rc3
    STAbs %0, 2000
    STAbs %1, 2001
    RTS
...

# Tighten the entry list: retain the used RC2, drop unused RC3, and omit RC0
# even though it is read, because it is reserved.
---
name: entry_liveins
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rc0, $rc2, $rc3
    ; CHECK-LABEL: name: entry_liveins
    ; CHECK: liveins: $rc2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY killed $rc2
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $rc0
    ; CHECK-NEXT: STAbs killed [[COPY]], 2000
    ; CHECK-NEXT: STAbs killed [[COPY1]], 2001
    ; CHECK-NEXT: RTS
    ;
    ; HW-LABEL: name: entry_liveins
    ; HW: liveins: $rc2
    ; HW-NEXT: {{  $}}
    ; HW-NEXT: $y = LDImag8 $rc0
    ; HW-NEXT: $a = LDImag8 killed $rc2
    ; HW-NEXT: STAbs killed $a, 2000
    ; HW-NEXT: STAbs killed $y, 2001
    ; HW-NEXT: RTS
    %0:gpr = COPY $rc2
    %1:gpr = COPY $rc0
    STAbs %0, 2000
    STAbs %1, 2001
    RTS
...

# Killing the old tied input must not release the physical early-clobber
# result. The following virtual definition must use a different backing.
---
name: physical_early_tie
# ASSIGN-LABEL: name: physical_early_tie
# ASSIGN: id: 0, {{.*}}assigned-phys: '$rc3'
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rc2
    ; CHECK-LABEL: name: physical_early_tie
    ; CHECK: liveins: $rc2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: early-clobber $rc2 = IncMB $rc2(tied-def 0), implicit-def dead $c, implicit-def dead $v, implicit killed $rc2lsb
    ; CHECK-NEXT: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: $a = COPY killed $rc2
    ; CHECK-NEXT: STAbs killed $a, 2000
    ; CHECK-NEXT: STAbs killed [[LDAbs]], 2001
    ; CHECK-NEXT: RTS
    ;
    ; HW-LABEL: name: physical_early_tie
    ; HW: liveins: $rc2
    ; HW-NEXT: {{  $}}
    ; HW-NEXT: early-clobber $rc2 = IncMB killed $rc2(tied-def 0), implicit-def dead $c, implicit-def dead $v, implicit killed $rc2lsb
    ; HW-NEXT: $x = LDAbs 1000
    ; HW-NEXT: $a = COPY killed $rc2
    ; HW-NEXT: STAbs killed $a, 2000
    ; HW-NEXT: STAbs killed $x, 2001
    ; HW-NEXT: RTS
    early-clobber $rc2 = IncMB $rc2(tied-def 0), implicit-def $c, implicit-def $v
    %0:gpr = LDAbs 1000
    $a = COPY $rc2
    STAbs $a, 2000
    STAbs %0, 2001
    RTS
...

# Equal live copies may share a fixed destination without evacuating one another.
---
name: fixed_equal_copies
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: fixed_equal_copies
    ; CHECK: [[LDAbs:%[0-9]+]]:gpr = LDAbs 1000
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY [[LDAbs]]
    ; CHECK-NEXT: $rc2 = COPY [[COPY]]
    ; CHECK-NEXT: JSR &callee, implicit killed $rc2
    ; CHECK-NEXT: STAbs killed [[LDAbs]], 2000
    ; CHECK-NEXT: STAbs killed [[COPY]], 2001
    ; CHECK-NEXT: RTS
    ;
    ; HW-LABEL: name: fixed_equal_copies
    ; HW: $a = LDAbs 1000
    ; HW-NEXT: $rc2 = STImag8 $a
    ; HW-NEXT: JSR &callee, implicit killed $rc2
    ; HW-NEXT: STAbs $a, 2000
    ; HW-NEXT: STAbs killed $a, 2001
    ; HW-NEXT: RTS
    %0:gpr = LDAbs 1000
    %1:gpr = COPY %0
    $rc2 = COPY %1
    JSR &callee, implicit $rc2
    STAbs %0, 2000
    STAbs %1, 2001
    RTS
...

# Killing one copy does not release storage still holding the old value for
# another live copy. A destructive tie must use a separate location.
---
name: tied_equal_copies
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: tied_equal_copies
    ; CHECK: [[COPY:%[0-9]+]]:anyi8 = COPY $rc0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:anyi8 = COPY [[COPY]]
    ; CHECK-NEXT: [[PCOPY:%[0-9]+]]:anyi8 = PCOPY killed [[COPY1]]
    ; CHECK-NEXT: [[IncMB:%[0-9]+]]:anyi8 = IncMB killed [[PCOPY]](tied-def 0), implicit-def dead $c, implicit-def dead $v
    ; CHECK-NEXT: $a = COPY killed [[COPY]]
    ; CHECK-NEXT: STAbs killed $a, 2000
    ; CHECK-NEXT: $a = COPY killed [[IncMB]]
    ; CHECK-NEXT: STAbs killed $a, 2001
    ; CHECK-NEXT: RTS
    ;
    ; HW-LABEL: name: tied_equal_copies
    ; HW: $a = LDImag8 $rc0
    ; HW-NEXT: $x = TA $a
    ; HW-NEXT: $x = IncMB killed $x(tied-def 0), implicit-def dead $c, implicit-def dead $v
    ; HW-NEXT: STAbs killed $a, 2000
    ; HW-NEXT: $a = T_A killed $x
    ; HW-NEXT: STAbs killed $a, 2001
    ; HW-NEXT: RTS
    %0:anyi8 = COPY $rc0
    %1:anyi8 = COPY %0
    %2:anyi8 = IncMB %1(tied-def 0), implicit-def $c, implicit-def $v
    $a = COPY %0
    STAbs $a, 2000
    $a = COPY %2
    STAbs $a, 2001
    RTS
...
