# RUN: llc -mtriple=mos -run-pass=mos-conventional-ssa,mos-spill,mos-imag-regassign,mos-regalloc -verify-machineinstrs -o - %s | FileCheck %s

# rs0 contains the address of bb.1 or bb.2. CSSA copies must preserve those
# targets; imaginary and hardware allocation must not insert edge blocks that
# an indirect branch would bypass.
# CHECK-LABEL: name: indirect_phi
# CHECK: bb.0:
# CHECK-NEXT: successors: %bb.1(0x40000000), %bb.2(0x40000000)
# CHECK: JMPIndir $rs0

---
name: indirect_phi
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    %0:gpr = LDAbs 1000
    %1:gpr = LDAbs 1001
    JMPIndir $rs0
  bb.1:
    JMP %bb.2
  bb.2:
    %2:gpr = PHI %1, %bb.0, %0, %bb.1
    STAbs %2, 2000
    RTS
...
