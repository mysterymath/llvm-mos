Guard base/file.h under __PORTABLE_PLATFORM__.

We build with __PORTABLE_PLATFORM__ to avoid zlib/bzip2 dependencies.
drat_writer.h defines a stub 'class File {}' under portable mode, which
conflicts with the real File class in base/file.h. Guard the entire file
body so it becomes a no-op under portable mode.

--- a/ortools/base/file.h
+++ b/ortools/base/file.h
@@ -14,6 +14,11 @@
 #ifndef OR_TOOLS_BASE_FILE_H_
 #define OR_TOOLS_BASE_FILE_H_

+#if defined(__PORTABLE_PLATFORM__)
+// Under portable platform, drat_writer.h provides a minimal File stub.
+// Skip the full File class to avoid zlib and other system dependencies.
+#else
+
 #include <cstdint>
 #include <cstdio>
 #include <cstdlib>
@@ -166,4 +171,6 @@ absl::Status Exists(absl::string_view path, Options options);

 }  // namespace file

+#endif  // !__PORTABLE_PLATFORM__
+
 #endif  // OR_TOOLS_BASE_FILE_H_
